HACKMD_API_TOKEN=
# Optional. GA4 measurement ID (G-XXXXXXX); unset = no analytics tag.
PUBLIC_GA_ID=
# Optional. Search Console HTML-tag verification token; unset = no meta tag.
PUBLIC_GSC_VERIFICATION=

# Optional: local clone of Guildmages-Forum-Blog-Staff/images. When set,
# `npm run post` copies images from imgur/meee/postimg/HackMD into
# <IMAGES_DIR>/posts/<filename>/ and rewrites the post's URLs to point there.
IMAGES_DIR=
# IMAGES_BASE_URL=https://images.guildmagesforum.tw
