---
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { ClientRouter } from 'astro:transitions';
import { HTML_LANG, langFromPath, localePath } from '../i18n';
import { useTranslations } from '../i18n/ui';
import { getLangSwitch } from '../utils/collections';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** false for pages with no real URL of their own (e.g. 404). */
  canonical?: boolean;
  /** true keeps the page out of search indexes (e.g. preview posts). */
  noindex?: boolean;
  /** true for post pages: og:type=article plus the article:* times. */
  article?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
}
const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const {
  title,
  description = t.siteDescription,
  ogImage,
  canonical = true,
  noindex = false,
  article = false,
  publishedTime,
  modifiedTime,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// hreflang alternates: only languages that have this exact page. The other
// language's twin (or its fallback) is also where the Navbar toggle points.
const langSwitch = await getLangSwitch(Astro.url.pathname);
const alternates =
  canonical && langSwitch.exact
    ? [
        { lang, href: canonicalUrl.href },
        { lang: langSwitch.otherLang, href: new URL(langSwitch.href, Astro.site).href },
      ]
    : [];
// Social previews: absolute image URL, falling back to the site logo.
const ogImageUrl = new URL(ogImage ?? `${import.meta.env.BASE_URL}images/logo.jpg`, Astro.site)
  .href;
const OG_LOCALE = { 'zh-tw': 'zh_TW', en: 'en_US' } as const;
// Both optional: set at build time (CI repo variables); unset = tag omitted.
const gaId = import.meta.env.PUBLIC_GA_ID;
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href={`${import.meta.env.BASE_URL}images/logo.webp`} />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    {alternates.map((a) => <link rel="alternate" hreflang={HTML_LANG[a.lang]} href={a.href} />)}
    <meta name="gmf:lang-switch" content={langSwitch.href} />
    {noindex && <meta name="robots" content="noindex" />}
    <slot name="head" />
    {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
    {gaId && <GoogleAnalytics id={gaId} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonicalUrl.href} />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Guildmages' Forum 魔風集會所" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {
      alternates.length > 0 && (
        <meta property="og:locale:alternate" content={OG_LOCALE[langSwitch.otherLang]} />
      )
    }
    <meta property="og:image" content={ogImageUrl} />
    {
      article && publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {
      article && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime.toISOString()} />
      )
    }
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <title>{title} | {t.siteTitle}</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t.siteTitle}
      href={localePath(lang, 'rss.xml')}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <script is:inline>
      (function () {
        function applyStoredTheme() {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
        applyStoredTheme();
        document.addEventListener('astro:after-swap', applyStoredTheme);
      })();
    </script>
  </head>
  <body class="text-foreground dark:text-dark-fg flex min-h-screen flex-col">
    <div class="flex-1">
      <slot />
    </div>
    <Footer lang={lang} />
    <script>
      // Scryfall card hover — imgUrl sourced from server-side remark plugin attributes only.
      // ClientRouter swaps <body> wholesale on internal navigation (no transition:persist
      // on this tooltip) and only runs page scripts once per browser session, so
      // DOMContentLoaded alone left every page but the very first hard load with no
      // tooltip element and no listeners. astro:page-load fires after the initial load
      // AND every subsequent navigation, so rebuild the (possibly-detached) tooltip div
      // there each time; the mouseover/mousemove/mouseout listeners stay on `document`,
      // which persists across swaps, so they're attached once, outside this handler.
      let tooltip: HTMLDivElement | undefined;

      document.addEventListener('astro:page-load', () => {
        if (tooltip?.isConnected) return;
        tooltip = document.createElement('div');
        tooltip.id = 'scryfall-tooltip';
        tooltip.style.cssText =
          'position:fixed;z-index:9999;pointer-events:none;display:none;transition:opacity 0.15s;';
        document.body.appendChild(tooltip);
      });

      const CARD_IMG_CSS = 'width:223px;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,0.5);';

      function makeImg(src: string): HTMLImageElement {
        const img = document.createElement('img');
        img.src = src;
        img.width = 223;
        img.height = 311; // Scryfall card art ratio (488x680) at 223px width
        img.style.cssText = CARD_IMG_CSS;
        // eager: img starts inside a display:none tooltip that flips
        // visible on the same hover event — loading="lazy" defers the
        // fetch on first hover until browser catches up (fixed after a
        // reload warms the cache). No off-screen benefit to lazy here.
        return img;
      }

      document.addEventListener('mouseover', (e) => {
        if (!tooltip) return;
        const el = e.target as Element;

        // scryfall-card: image URL in data attribute
        const scryfallLink = el.closest('a.scryfall-card');
        if (scryfallLink) {
          const imgUrl = scryfallLink.getAttribute('data-card-image');
          if (!imgUrl) return;
          tooltip.replaceChildren(...imgUrl.split('|').filter(Boolean).map(makeImg));
          tooltip.style.display = 'flex';
          tooltip.style.gap = '8px';
          return;
        }

        // mtglink tooltip: image URL in data attribute (set by remark-mtg-tags)
        const tooltipLink = el.closest('a.tooltip');
        if (tooltipLink) {
          const imgUrl = tooltipLink.getAttribute('data-card-image');
          if (!imgUrl) return;
          tooltip.replaceChildren(makeImg(imgUrl));
          tooltip.style.display = 'flex';
          tooltip.style.gap = '8px';
        }
      });

      document.addEventListener('mousemove', (e) => {
        if (!tooltip || tooltip.style.display === 'none') return;
        const x = e.clientX + 16;
        const y = e.clientY - 20;
        const w = tooltip.offsetWidth || 240;
        tooltip.style.left = Math.min(x, window.innerWidth - w - 8) + 'px';
        tooltip.style.top = Math.max(0, Math.min(y, window.innerHeight - 340)) + 'px';
      });

      document.addEventListener('mouseout', (e) => {
        if (!tooltip) return;
        const el = e.target as Element;
        if (!el.closest('a.scryfall-card') && !el.closest('a.tooltip')) return;
        tooltip.style.display = 'none';
      });
    </script>
    <button
      id="scroll-top-btn"
      aria-label="Back to top"
      class="dark:bg-dark-bg/90 fixed right-6 bottom-6 z-50 hidden h-12 w-12 items-center justify-center rounded-full bg-white/90 shadow-lg backdrop-blur transition-opacity hover:opacity-80"
    >
      <svg class="absolute inset-0 h-12 w-12 -rotate-90" viewBox="0 0 48 48">
        <circle
          cx="24"
          cy="24"
          r="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          class="text-gray-200 dark:text-gray-700"></circle>
        <circle
          id="scroll-progress-ring"
          cx="24"
          cy="24"
          r="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          class="text-primary transition-[stroke-dashoffset] duration-100"
          style="stroke-dasharray: 125.66; stroke-dashoffset: 125.66;"></circle>
      </svg>
      <!-- Up arrow -->
      <svg
        class="relative h-4 w-4 text-gray-700 dark:text-gray-200"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"></path>
      </svg>
    </button>
    <script>
      (function () {
        const circumference = 125.66;
        let abort: AbortController | null = null;

        function setup() {
          abort?.abort();
          abort = new AbortController();
          const { signal } = abort;

          const btn = document.getElementById('scroll-top-btn');
          const ring = document.getElementById('scroll-progress-ring');
          if (!btn || !ring) return;

          window.addEventListener(
            'scroll',
            () => {
              const scrollTop = window.scrollY;
              const docHeight = document.documentElement.scrollHeight - window.innerHeight;
              const progress = docHeight > 0 ? scrollTop / docHeight : 0;

              if (scrollTop < 50) {
                btn.classList.remove('flex');
                btn.classList.add('hidden');
              } else {
                btn.classList.remove('hidden');
                btn.classList.add('flex');
              }

              ring.style.strokeDashoffset = String(circumference * (1 - progress));
            },
            { passive: true, signal },
          );

          btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }), {
            signal,
          });
        }

        setup();
        document.addEventListener('astro:after-swap', setup);
      })();
    </script>
  </body>
</html>
