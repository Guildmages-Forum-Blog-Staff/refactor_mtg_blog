---
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import { SITE_TITLE, SITE_DESCRIPTION } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const { title, description = SITE_DESCRIPTION, ogImage } = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href={`${import.meta.env.BASE_URL}images/logo.webp`} />
    <meta name="description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <title>{title} | {SITE_TITLE}</title>
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={`${import.meta.env.BASE_URL}rss.xml`}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <script is:inline>
      (function () {
        function applyStoredTheme() {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
        applyStoredTheme();
        document.addEventListener('astro:after-swap', applyStoredTheme);
      })();
    </script>
  </head>
  <body class="text-foreground dark:text-dark-fg flex min-h-screen flex-col">
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
    <script>
      // Scryfall card hover — imgUrl sourced from server-side remark plugin attributes only
      document.addEventListener('DOMContentLoaded', () => {
        const tooltip = document.createElement('div');
        tooltip.id = 'scryfall-tooltip';
        tooltip.style.cssText =
          'position:fixed;z-index:9999;pointer-events:none;display:none;transition:opacity 0.15s;';
        document.body.appendChild(tooltip);

        const CARD_IMG_CSS =
          'width:223px;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,0.5);';

        function makeImg(src: string): HTMLImageElement {
          const img = document.createElement('img');
          img.src = src;
          img.style.cssText = CARD_IMG_CSS;
          img.loading = 'lazy';
          return img;
        }

        document.addEventListener('mouseover', (e) => {
          const el = e.target as Element;

          // scryfall-card: image URL in data attribute
          const scryfallLink = el.closest('a.scryfall-card');
          if (scryfallLink) {
            const imgUrl = scryfallLink.getAttribute('data-card-image');
            if (!imgUrl) return;
            tooltip.replaceChildren(...imgUrl.split('|').filter(Boolean).map(makeImg));
            tooltip.style.display = 'flex';
            tooltip.style.gap = '8px';
            return;
          }

          // mtglink tooltip: image URL in data attribute (set by remark-mtg-tags)
          const tooltipLink = el.closest('a.tooltip');
          if (tooltipLink) {
            const imgUrl = tooltipLink.getAttribute('data-card-image');
            if (!imgUrl) return;
            tooltip.replaceChildren(makeImg(imgUrl));
            tooltip.style.display = 'flex';
            tooltip.style.gap = '8px';
          }
        });

        document.addEventListener('mousemove', (e) => {
          if (tooltip.style.display === 'none') return;
          const x = e.clientX + 16;
          const y = e.clientY - 20;
          const w = tooltip.offsetWidth || 240;
          tooltip.style.left = Math.min(x, window.innerWidth - w - 8) + 'px';
          tooltip.style.top = Math.max(0, Math.min(y, window.innerHeight - 340)) + 'px';
        });

        document.addEventListener('mouseout', (e) => {
          const el = e.target as Element;
          if (!el.closest('a.scryfall-card') && !el.closest('a.tooltip')) return;
          tooltip.style.display = 'none';
        });
      });
    </script>
    <button
      id="scroll-top-btn"
      aria-label="Back to top"
      class="dark:bg-dark-bg/90 fixed right-6 bottom-6 z-50 hidden h-12 w-12 items-center justify-center rounded-full bg-white/90 shadow-lg backdrop-blur transition-opacity hover:opacity-80"
    >
      <svg class="absolute inset-0 h-12 w-12 -rotate-90" viewBox="0 0 48 48">
        <circle
          cx="24"
          cy="24"
          r="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          class="text-gray-200 dark:text-gray-700"></circle>
        <circle
          id="scroll-progress-ring"
          cx="24"
          cy="24"
          r="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          class="text-primary transition-[stroke-dashoffset] duration-100"
          style="stroke-dasharray: 125.66; stroke-dashoffset: 125.66;"></circle>
      </svg>
      <!-- Up arrow -->
      <svg
        class="relative h-4 w-4 text-gray-700 dark:text-gray-200"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"></path>
      </svg>
    </button>
    <script>
      (function () {
        const circumference = 125.66;
        let abort: AbortController | null = null;

        function setup() {
          abort?.abort();
          abort = new AbortController();
          const { signal } = abort;

          const btn = document.getElementById('scroll-top-btn');
          const ring = document.getElementById('scroll-progress-ring');
          if (!btn || !ring) return;

          window.addEventListener(
            'scroll',
            () => {
              const scrollTop = window.scrollY;
              const docHeight = document.documentElement.scrollHeight - window.innerHeight;
              const progress = docHeight > 0 ? scrollTop / docHeight : 0;

              if (scrollTop < 50) {
                btn.classList.remove('flex');
                btn.classList.add('hidden');
              } else {
                btn.classList.remove('hidden');
                btn.classList.add('flex');
              }

              ring.style.strokeDashoffset = String(circumference * (1 - progress));
            },
            { passive: true, signal },
          );

          btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }), {
            signal,
          });
        }

        setup();
        document.addEventListener('astro:after-swap', setup);
      })();
    </script>
  </body>
</html>
