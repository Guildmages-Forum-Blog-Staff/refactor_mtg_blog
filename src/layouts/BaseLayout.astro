---
import Footer from '../components/Footer.astro';
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const {
  title,
  description = "Guildmages' Forum 魔風集會所是一個繁體中文的部落格，致力於推廣魔法風雲會競技型賽制。",
  ogImage,
} = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/webp" href="/refactor_mtg_blog/images/logo.webp" />
    <meta name="description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <title>{title} | Guildmages' Forum 魔風集會所</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <ViewTransitions />
    <script is:inline>
      (function () {
        function applyStoredTheme() {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        }
        applyStoredTheme();
        document.addEventListener('astro:after-swap', applyStoredTheme);
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col font-sans text-foreground dark:text-dark-fg">
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
    <script>
      // Scryfall card hover — imgUrl sourced from server-side remark plugin attributes only
      document.addEventListener('DOMContentLoaded', () => {
        const tooltip = document.createElement('div');
        tooltip.id = 'scryfall-tooltip';
        tooltip.style.cssText =
          'position:fixed;z-index:9999;pointer-events:none;display:none;transition:opacity 0.15s;';
        document.body.appendChild(tooltip);

        document.addEventListener('mouseover', (e) => {
          const link = (e.target as Element).closest('a.scryfall-card');
          if (!link) return;
          const imgUrl = link.getAttribute('data-card-image');
          if (!imgUrl) return;
          const urls = imgUrl.split('|').filter(Boolean);
          tooltip.replaceChildren(
            ...urls.map((src) => {
              const img = document.createElement('img');
              img.src = src;
              img.style.cssText =
                'width:223px;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,0.5);';
              img.loading = 'lazy';
              return img;
            }),
          );
          tooltip.style.display = 'flex';
          tooltip.style.gap = '8px';
        });

        document.addEventListener('mousemove', (e) => {
          if (tooltip.style.display === 'none') return;
          const x = e.clientX + 16;
          const y = e.clientY - 20;
          const w = tooltip.offsetWidth || 240;
          tooltip.style.left = Math.min(x, window.innerWidth - w - 8) + 'px';
          tooltip.style.top = Math.max(0, Math.min(y, window.innerHeight - 340)) + 'px';
        });

        document.addEventListener('mouseout', (e) => {
          if (!(e.target as Element).closest('a.scryfall-card')) return;
          tooltip.style.display = 'none';
        });
      });
    </script>
    <button
      id="scroll-top-btn"
      aria-label="Back to top"
      class="fixed bottom-6 right-6 z-50 hidden h-12 w-12 items-center justify-center rounded-full bg-white/90 shadow-lg backdrop-blur transition-opacity hover:opacity-80 dark:bg-dark-bg/90"
    >
      <svg class="absolute inset-0 h-12 w-12 -rotate-90" viewBox="0 0 48 48">
        <circle
          cx="24"
          cy="24"
          r="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          class="text-gray-200 dark:text-gray-700"></circle>
        <circle
          id="scroll-progress-ring"
          cx="24"
          cy="24"
          r="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          class="text-primary transition-[stroke-dashoffset] duration-100"
          style="stroke-dasharray: 125.66; stroke-dashoffset: 125.66;"></circle>
      </svg>
      <!-- Up arrow -->
      <svg
        class="relative h-4 w-4 text-gray-700 dark:text-gray-200"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"></path>
      </svg>
    </button>
    <script>
      (function () {
        const circumference = 125.66;
        let abort: AbortController | null = null;

        function setup() {
          abort?.abort();
          abort = new AbortController();
          const { signal } = abort;

          const btn = document.getElementById('scroll-top-btn');
          const ring = document.getElementById('scroll-progress-ring');
          if (!btn || !ring) return;

          window.addEventListener(
            'scroll',
            () => {
              const scrollTop = window.scrollY;
              const docHeight = document.documentElement.scrollHeight - window.innerHeight;
              const progress = docHeight > 0 ? scrollTop / docHeight : 0;

              if (scrollTop < 50) {
                btn.classList.remove('flex');
                btn.classList.add('hidden');
              } else {
                btn.classList.remove('hidden');
                btn.classList.add('flex');
              }

              ring.style.strokeDashoffset = String(circumference * (1 - progress));
            },
            { passive: true, signal },
          );

          btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }), {
            signal,
          });
        }

        setup();
        document.addEventListener('astro:after-swap', setup);
      })();
    </script>
  </body>
</html>
