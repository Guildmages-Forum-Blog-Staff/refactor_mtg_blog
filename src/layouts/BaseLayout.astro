---
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const {
  title,
  description = "Guildmages' Forum 魔風集會所是一個繁體中文的部落格，致力於推廣魔法風雲會競技型賽制。",
  ogImage,
} = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <title>{title} | Guildmages' Forum 魔風集會所</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white font-sans text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <slot />
    <Footer />
    <script>
      // Scryfall card hover — imgUrl sourced from server-side remark plugin attributes only
      document.addEventListener('DOMContentLoaded', () => {
        const tooltip = document.createElement('div');
        tooltip.id = 'scryfall-tooltip';
        tooltip.style.cssText =
          'position:fixed;z-index:9999;pointer-events:none;display:none;transition:opacity 0.15s;';
        document.body.appendChild(tooltip);

        document.addEventListener('mouseover', (e) => {
          const link = (e.target as Element).closest('a.scryfall-card');
          if (!link) return;
          const imgUrl = link.getAttribute('data-card-image');
          if (!imgUrl) return;
          const img = document.createElement('img');
          img.src = imgUrl;
          img.style.cssText =
            'width:223px;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,0.5);';
          img.loading = 'lazy';
          tooltip.replaceChildren(img);
          tooltip.style.display = 'block';
        });

        document.addEventListener('mousemove', (e) => {
          if (tooltip.style.display === 'none') return;
          const x = e.clientX + 16;
          const y = e.clientY - 20;
          tooltip.style.left = Math.min(x, window.innerWidth - 240) + 'px';
          tooltip.style.top = Math.max(0, Math.min(y, window.innerHeight - 340)) + 'px';
        });

        document.addEventListener('mouseout', (e) => {
          if (!(e.target as Element).closest('a.scryfall-card')) return;
          tooltip.style.display = 'none';
        });
      });
    </script>
    <script>
      (function () {
        const memCache = new Map();

        function getImageUrl(card) {
          if (card.image_uris) return card.image_uris.large;
          if (card.card_faces && card.card_faces[0] && card.card_faces[0].image_uris) {
            return card.card_faces[0].image_uris.large;
          }
          return null;
        }

        async function fetchByName(name, edition, language) {
          const key = `name:${name}:${edition}:${language}`;
          if (memCache.has(key)) return memCache.get(key);
          let url = `https://api.scryfall.com/cards/named?exact=${encodeURIComponent(name)}`;
          if (edition) url += `&set=${encodeURIComponent(edition)}`;
          const res = await fetch(url);
          if (!res.ok) throw new Error(`${res.status}: ${name}`);
          const data = await res.json();
          memCache.set(key, data);
          return data;
        }

        async function fetchByNumber(edition, number, language) {
          const key = `pick:${edition}:${number}:${language}`;
          if (memCache.has(key)) return memCache.get(key);
          let url = `https://api.scryfall.com/cards/${encodeURIComponent(edition)}/${encodeURIComponent(number)}`;
          if (language && language !== 'en') url += `/${encodeURIComponent(language)}`;
          const res = await fetch(url);
          if (!res.ok) throw new Error(`${res.status}: ${edition}/${number}`);
          const data = await res.json();
          memCache.set(key, data);
          return data;
        }

        async function processElement(el, delay) {
          await new Promise((r) => setTimeout(r, delay));
          try {
            const edition = el.dataset.edition || '';
            const language = el.dataset.language || 'en';
            const number = el.dataset.number;
            const cardName = el.dataset.cardName;

            const card = number
              ? await fetchByNumber(edition, number, language)
              : await fetchByName(cardName, edition, language);

            const imageUrl = getImageUrl(card);
            if (!imageUrl) return;

            if (el.tagName === 'SPAN') {
              el.outerHTML = `<img src="${imageUrl}" class="mtgcard rounded-lg my-4 max-w-xs" loading="lazy" alt="${card.name}" />`;
            } else {
              el.dataset.cardImage = imageUrl;
              if (!el.textContent.trim()) el.textContent = card.name;
            }
          } catch (e) {
            console.warn('[mtg] fetch failed:', e.message);
          }
        }

        document.addEventListener('DOMContentLoaded', function () {
          const els = Array.from(document.querySelectorAll('.mtg-link, .mtg-card-img, .mtg-card-pick'));
          els.forEach((el, i) => processElement(el, i * 100));
        });
      })();
    </script>
  </body>
</html>
