---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import { getPostAuthors } from '../utils/authors';
import { buildCategoryBreadcrumbs } from '../utils/categories';

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const allPosts = await getCollection('posts');
  const sorted = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return paginate(sorted, { pageSize: 10 });
}

const { page } = Astro.props;

const postsWithAuthors = await Promise.all(
  page.data.map(async (post: any) => ({
    post,
    authors: await getPostAuthors(post.data.authors),
  })),
);

function getPaginationItems(current: number, last: number): (number | '...')[] {
  if (last <= 1) return [1];
  const delta = 2;
  const left = current - delta;
  const right = current + delta;
  const pages: number[] = [];
  for (let i = 1; i <= last; i++) {
    if (i === 1 || i === last || (i >= left && i <= right)) pages.push(i);
  }
  const result: (number | '...')[] = [];
  let prev: number | null = null;
  for (const p of pages) {
    if (prev !== null) {
      if (p - prev === 2) result.push(prev + 1);
      else if (p - prev > 2) result.push('...');
    }
    result.push(p);
    prev = p;
  }
  return result;
}

const paginationItems = getPaginationItems(page.currentPage, page.lastPage);
const isFirstPage = page.currentPage === 1;
---

<BaseLayout title={page.currentPage === 1 ? 'Home' : `Home — Page ${page.currentPage}`}>
  <Navbar />

  {isFirstPage && (
    <>
      <!-- Hero section -->
      <section class="flex h-screen items-center justify-center">
        <div class="text-center">
          <h1 class="text-4xl font-bold text-white drop-shadow-2xl tracking-tight md:text-6xl">
            Guildmages' Forum
          </h1>
          <p class="mt-4 text-xl font-medium text-white drop-shadow-lg md:text-3xl">
            魔風集會所
          </p>
          <p class="mt-8 min-h-[1.5em] text-lg text-white/80 drop-shadow">
            <span id="hero-tw-text"></span><span class="hero-cursor">|</span>
          </p>
        </div>
      </section>
    </>
  )}

  <div>
    <main class="mx-auto max-w-3xl px-4 py-10">
      {!isFirstPage && (
        <h1 class="mb-8 text-3xl font-bold text-gray-900 dark:text-gray-100">
          Guildmages' Forum <span class="text-primary">魔風集會所</span>
        </h1>
      )}
      <div id="post-list" class="flex flex-col gap-8">
        {
          postsWithAuthors.map(({ post, authors }: any) => (
            <article class="post-card overflow-hidden rounded-2xl bg-white shadow-md backdrop-blur-sm dark:bg-dark-bg">
              {(post.data.cover || post.data.thumbnail) && (
                <a href={`${import.meta.env.BASE_URL}${post.id.replace(/\.mdx?$/, '')}`}>
                  <img
                    src={post.data.cover || post.data.thumbnail}
                    alt={post.data.title}
                    loading="lazy"
                    class="h-48 w-full object-cover"
                  />
                </a>
              )}
              <div class="p-5">
                <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                  <div class="flex flex-wrap gap-2">
                    {buildCategoryBreadcrumbs(post.data.categories).map(({ label, cat }) => (
                      <a
                        href={`${import.meta.env.BASE_URL}categories/${encodeURIComponent(cat)}/`}
                        class="rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary transition-colors hover:bg-primary/20"
                      >
                        {label}
                      </a>
                    ))}
                  </div>
                  <time class="shrink-0 text-xs text-gray-400 dark:text-gray-500">
                    {post.data.date.toLocaleDateString('zh-TW')}
                  </time>
                </div>
                <a href={`${import.meta.env.BASE_URL}${post.id.replace(/\.mdx?$/, '')}`}>
                  <h2 class="mb-2 text-xl font-bold text-gray-900 transition-colors hover:text-primary dark:text-gray-100">
                    {post.data.title}
                  </h2>
                </a>
                {post.data.excerpt && (
                  <p class="mb-3 text-sm leading-relaxed text-gray-600 dark:text-gray-400">
                    {post.data.excerpt}
                  </p>
                )}
                {authors.length > 0 && (
                  <div class="flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400">
                    {authors.map((author: any) => (
                      <a
                        href={`${import.meta.env.BASE_URL}authors/${author.id}`}
                        class="flex items-center gap-1 transition-colors hover:text-primary"
                      >
                        <img
                          src={author.avatar}
                          alt={author.name}
                          loading="lazy"
                          class="h-5 w-5 rounded-full object-cover"
                        />
                        <span>{author.name}</span>
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <!-- Pagination -->
      <nav class="mt-12 flex items-center justify-between" aria-label="Pagination">
        <div>
          {
            page.url.prev ? (
              <a
                href={page.url.prev}
                class="flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-100 hover:text-primary dark:text-dark-fg/70 dark:hover:bg-white/10 dark:hover:text-primary"
              >
                ← Prev
              </a>
            ) : (
              <span class="flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-gray-300 dark:text-dark-fg/30">
                ← Prev
              </span>
            )
          }
        </div>

        <div class="flex items-center gap-1">
          {
            paginationItems.map((item) =>
              item === '...' ? (
                <span class="px-1 text-sm text-gray-400 dark:text-dark-fg/30">…</span>
              ) : (
                <a
                  href={item === 1 ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}${item}`}
                  class={`min-w-[2rem] rounded-md px-2 py-1 text-center text-sm font-medium transition-colors ${
                    item === page.currentPage
                      ? 'bg-primary text-white'
                      : 'text-gray-600 hover:bg-gray-100 hover:text-primary dark:text-dark-fg/70 dark:hover:bg-white/10 dark:hover:text-primary'
                  }`}
                >
                  {item}
                </a>
              ),
            )
          }
        </div>

        <div>
          {
            page.url.next ? (
              <a
                href={page.url.next}
                class="flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-100 hover:text-primary dark:text-dark-fg/70 dark:hover:bg-white/10 dark:hover:text-primary"
              >
                Next →
              </a>
            ) : (
              <span class="flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-gray-300 dark:text-dark-fg/30">
                Next →
              </span>
            )
          }
        </div>
      </nav>
    </main>
  </div>
</BaseLayout>

<script>
  const heroBg = document.getElementById('hero-bg');
  const isHeroPage = !!document.getElementById('hero-tw-text');
  if (heroBg && isHeroPage) {
    const postList = document.getElementById('post-list');
    const firstPost = postList ? postList.querySelector('article') : null;
    if (firstPost) {
      window.addEventListener(
        'scroll',
        () => {
          const progress = Math.max(
            0,
            Math.min(
              1,
              (window.innerHeight - firstPost.getBoundingClientRect().top) /
                (window.innerHeight / 2),
            ),
          );
          heroBg.style.filter = `blur(${progress * 12}px)`;
        },
        { passive: true },
      );
    }
  }
</script>

<script>
  const tw = document.getElementById('hero-tw-text');
  if (tw) {
    const lines = ['各路旅法師的集散地', '讓玩家額外有個 +1/+1 指示物', '釋放各路玩家的限制', '盡情享受遊戲', '不瘋魔不成活'];
    let lineIdx = 0;
    let charIdx = 0;
    let deleting = false;
    let waitTimer: ReturnType<typeof setTimeout> | null = null;

    function tick() {
      const current = lines[lineIdx];
      if (!deleting) {
        charIdx++;
        tw.textContent = current.slice(0, charIdx);
        if (charIdx === current.length) {
          waitTimer = setTimeout(() => { deleting = true; tick(); }, 2000);
          return;
        }
        setTimeout(tick, 80);
      } else {
        charIdx--;
        tw.textContent = current.slice(0, charIdx);
        if (charIdx === 0) {
          deleting = false;
          lineIdx = (lineIdx + 1) % lines.length;
          setTimeout(tick, 300);
          return;
        }
        setTimeout(tick, 40);
      }
    }

    const initialTimer = setTimeout(tick, 600);
    document.addEventListener('astro:before-swap', () => {
      clearTimeout(initialTimer);
      if (waitTimer !== null) clearTimeout(waitTimer);
    }, { once: true });
  }
</script>

<script>
  function initCardReveal() {
    const cards = document.querySelectorAll<HTMLElement>('.post-card');
    if (!cards.length) return;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.1 },
    );
    cards.forEach((card) => observer.observe(card));
  }

  initCardReveal();
  document.addEventListener('astro:after-swap', initCardReveal);
</script>
