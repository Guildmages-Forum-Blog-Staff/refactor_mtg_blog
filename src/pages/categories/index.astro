---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import { CATEGORY_TREE } from '../../config/category-tree';
import { excludePreviewPosts } from '../../utils/posts';

const posts = excludePreviewPosts(await getCollection('posts'));

const countMap = new Map<string, number>();
for (const post of posts) {
  for (const cat of post.data.categories) {
    countMap.set(cat, (countMap.get(cat) ?? 0) + 1);
  }
}

function catLink(name: string) {
  return `${import.meta.env.BASE_URL}categories/${encodeURIComponent(name)}`;
}

function count(name: string) {
  return countMap.get(name) ?? 0;
}
---

<BaseLayout title="Categories">
  <Navbar />
  <main class="mx-auto max-w-3xl px-4 py-10">
    <div class="dark:bg-dark-bg/80 rounded-2xl bg-white/80 p-6 backdrop-blur-sm">
      <h1 class="mb-8 text-3xl font-bold text-gray-900 dark:text-gray-100">Categories</h1>

      <ul class="flex flex-col gap-1">
        {
          CATEGORY_TREE.map((node) => (
            <li>
              {node.children && node.children.length > 0 ? (
                <details class="group" open>
                  <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg px-3 py-2 transition-colors hover:bg-gray-100 dark:hover:bg-white/5">
                    <svg
                      class="h-4 w-4 shrink-0 text-gray-400 transition-transform group-open:rotate-90"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                    <a
                      href={catLink(node.name)}
                      data-stop-toggle
                      class="hover:text-primary dark:hover:text-primary flex-1 font-semibold text-gray-800 transition-colors dark:text-gray-200"
                    >
                      {node.name}
                    </a>
                    <span class="bg-primary rounded-full px-2 py-0.5 text-xs font-semibold text-white">
                      {count(node.name)}
                    </span>
                  </summary>
                  <ul class="mt-1 ml-8 flex flex-col gap-0.5 border-l border-gray-200 pl-4 dark:border-gray-700">
                    {node.children.map((child) => (
                      <li>
                        <a
                          href={catLink(child)}
                          class="hover:text-primary dark:hover:text-primary flex items-center justify-between rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-gray-100 dark:hover:bg-white/5"
                        >
                          <span class="text-gray-700 dark:text-gray-300">{child}</span>
                          <span class="ml-2 text-xs text-gray-400 dark:text-gray-500">
                            {count(child)}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a
                  href={catLink(node.name)}
                  class="flex items-center justify-between rounded-lg px-3 py-2 transition-colors hover:bg-gray-100 dark:hover:bg-white/5"
                >
                  <span class="hover:text-primary dark:hover:text-primary font-semibold text-gray-800 transition-colors dark:text-gray-200">
                    {node.name}
                  </span>
                  <span class="bg-primary rounded-full px-2 py-0.5 text-xs font-semibold text-white">
                    {count(node.name)}
                  </span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </main>
</BaseLayout>

<script>
  document
    .querySelectorAll<HTMLAnchorElement>('a[data-stop-toggle]')
    .forEach((a) => a.addEventListener('click', (e) => e.stopPropagation()));
</script>
