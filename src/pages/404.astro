---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404 找不到頁面">
  <Navbar />
  <main class="mx-auto max-w-4xl px-4 py-10">
    <div
      class="dark:bg-dark-bg/80 flex flex-col items-center rounded-2xl bg-white/80 p-6 py-24 text-center backdrop-blur-sm"
    >
      <h1 class="text-primary text-6xl font-bold">404</h1>
      <p class="mt-4 text-xl text-gray-900 dark:text-gray-100">找不到這個頁面</p>
      <p class="mt-2 text-gray-500 dark:text-gray-400">可能是連結有誤，或頁面已被移除。</p>
      <a
        href={base}
        class="bg-primary mt-8 rounded-full px-6 py-2 font-medium text-white transition hover:opacity-90"
      >
        回首頁
      </a>
    </div>
  </main>
</BaseLayout>
