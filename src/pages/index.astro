---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import { getPostAuthors } from '../utils/authors';

const allPosts = await getCollection('posts');
const sorted = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Resolve authors for all posts
const postsWithAuthors = await Promise.all(
  sorted.map(async post => ({
    post,
    authors: await getPostAuthors(post.data.authors),
  }))
);
---

<BaseLayout title="Home">
  <Navbar />
  <main class="max-w-3xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold mb-8 text-gray-900 dark:text-gray-100">
      Guildmages' Forum <span class="text-primary">魔風集會所</span>
    </h1>
    <div class="flex flex-col gap-8">
      {postsWithAuthors.map(({ post, authors }) => (
        <article class="border-b border-gray-100 dark:border-gray-800 pb-8">
          {(post.data.cover || post.data.thumbnail) && (
            <a href={`/${post.id.replace(/\.mdx?$/, '')}`}>
              <img
                src={post.data.cover || post.data.thumbnail}
                alt={post.data.title}
                class="w-full h-48 object-cover rounded-lg mb-4"
              />
            </a>
          )}
          <div class="flex flex-wrap gap-2 mb-2">
            {post.data.categories.map(cat => (
              <a
                href={`/categories/${encodeURIComponent(cat)}`}
                class="text-xs font-medium text-primary hover:underline"
              >
                {cat}
              </a>
            ))}
          </div>
          <a href={`/${post.id.replace(/\.mdx?$/, '')}`}>
            <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 hover:text-primary transition-colors mb-2">
              {post.data.title}
            </h2>
          </a>
          {post.data.excerpt && (
            <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed mb-3">
              {post.data.excerpt}
            </p>
          )}
          <div class="flex items-center gap-3 text-sm text-gray-500 dark:text-gray-400">
            <time>{post.data.date.toLocaleDateString('zh-TW')}</time>
            {authors.length > 0 && (
              <div class="flex items-center gap-1.5">
                {authors.map(author => (
                  <a
                    href={author.url || `/tags/${author.id}`}
                    class="flex items-center gap-1 hover:text-primary transition-colors"
                  >
                    <img
                      src={author.avatar}
                      alt={author.name}
                      class="w-5 h-5 rounded-full object-cover"
                    />
                    <span>{author.name}</span>
                  </a>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>
