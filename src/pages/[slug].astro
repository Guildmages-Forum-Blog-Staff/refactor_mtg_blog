---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import ArticleAuthorHeader from '../components/ArticleAuthorHeader.vue';
import ArticleAuthorFooter from '../components/ArticleAuthorFooter.vue';
import TableOfContents from '../components/TableOfContents.vue';
import WalineComments from '../components/WalineComments.vue';
import RelatedPosts from '../components/RelatedPosts.astro';
import { getPostAuthors } from '../utils/authors';
import { getRelatedPosts } from '../utils/related';
import { buildCategoryBreadcrumbs } from '../utils/categories';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const authors = await getPostAuthors(post.data.authors);
const allPosts = await getCollection('posts');
const relatedPosts = getRelatedPosts(post, allPosts);

const coverImage = post.data.cover || post.data.thumbnail;
---

<BaseLayout title={post.data.title} description={post.data.excerpt} ogImage={coverImage}>
  <Navbar />

  {headings.length > 0 && (
    <button
      id="toc-toggle"
      aria-label="Toggle table of contents"
      aria-expanded="false"
      class="fixed top-20 right-6 z-50 flex h-10 w-10 items-center justify-center rounded-full bg-white/90 shadow-lg backdrop-blur transition-opacity hover:opacity-80 dark:bg-dark-bg/90"
    >
      <svg class="h-5 w-5 text-gray-700 dark:text-gray-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h10M4 18h7" />
      </svg>
    </button>
  )}

  <main class="mx-auto max-w-6xl px-4 py-8">
    {
      coverImage && (
        <img
          src={coverImage}
          alt={post.data.title}
          loading="lazy"
          class="mb-8 h-64 w-full rounded-xl object-cover md:h-80"
        />
      )
    }

    <div class="flex gap-8 rounded-2xl bg-white/80 p-6 backdrop-blur-sm dark:bg-dark-bg/80">
      <!-- Article content -->
      <article class="min-w-0 flex-1 overflow-x-hidden" data-pagefind-body>
        <h1
          class="mb-4 text-3xl font-bold leading-tight text-gray-900 dark:text-gray-100 md:text-4xl"
        >
          {post.data.title}
        </h1>

        <!-- Author header with date, categories, views -->
        <ArticleAuthorHeader
          authors={authors}
          date={post.data.date.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}
          categories={buildCategoryBreadcrumbs(post.data.categories)}
          client:load
        />

        <!-- Content -->
        <div
          class="prose prose-lg max-w-none dark:prose-invert prose-headings:font-bold prose-a:text-primary prose-code:before:content-none prose-code:after:content-none prose-table:text-sm prose-img:rounded-lg"
        >
          <Content />
        </div>

        <!-- Author footer -->
        <div data-pagefind-ignore>
          <ArticleAuthorFooter authors={authors} client:load />
        </div>

        <!-- CC license block -->
        <div data-pagefind-ignore class="mt-8 rounded-xl border border-gray-200 bg-gray-50 px-5 py-4 text-sm text-gray-600 dark:border-gray-700 dark:bg-dark-bg dark:text-dark-fg/70">
          <dl class="flex flex-col gap-1.5">
            <div class="flex gap-2">
              <dt class="w-24 shrink-0 font-semibold text-gray-700 dark:text-dark-fg/90">Title</dt>
              <dd>{post.data.title}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="w-24 shrink-0 font-semibold text-gray-700 dark:text-dark-fg/90">Author</dt>
              <dd>{authors.map((a) => a.name).join(', ')}</dd>
            </div>
            <div class="flex gap-2">
              <dt class="w-24 shrink-0 font-semibold text-gray-700 dark:text-dark-fg/90">Created at</dt>
              <dd>{post.data.date.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}</dd>
            </div>
            {post.data.updated && (
              <div class="flex gap-2">
                <dt class="w-24 shrink-0 font-semibold text-gray-700 dark:text-dark-fg/90">Updated at</dt>
                <dd>{post.data.updated.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}</dd>
              </div>
            )}
            <div class="flex gap-2">
              <dt class="w-24 shrink-0 font-semibold text-gray-700 dark:text-dark-fg/90">Link</dt>
              <dd><a href={Astro.url.href} class="break-all text-primary hover:underline">{Astro.url.href}</a></dd>
            </div>
            <div class="flex gap-2">
              <dt class="w-24 shrink-0 font-semibold text-gray-700 dark:text-dark-fg/90">License</dt>
              <dd>
                This work is licensed under{' '}
                <a href="https://creativecommons.org/licenses/by-nc-sa/4.0" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                  CC BY-NC-SA 4.0
                </a>.
              </dd>
            </div>
          </dl>
        </div>

        <!-- Related posts -->
        <div data-pagefind-ignore>
          <RelatedPosts posts={relatedPosts} />
        </div>

        <!-- Comments -->
        <div data-pagefind-ignore class="mt-12 border-t border-gray-200 pt-8 dark:border-gray-700">
          <WalineComments path={`/${post.id.replace(/\.mdx?$/, '')}`} client:only="vue" />
        </div>
      </article>

      <!-- TOC sidebar -->
      {
        headings.length > 0 && (
          <aside id="toc-aside" class="hidden w-64 shrink-0 xl:block">
            <TableOfContents headings={headings} title={post.data.title} client:load />
          </aside>
        )
      }
    </div>
  </main>
</BaseLayout>

<style is:global>
  /* Mobile: fixed panel, always in DOM, slides in from right */
  @media (max-width: 1279px) {
    #toc-aside {
      display: block !important;
      position: fixed;
      top: 3.5rem;
      right: 0;
      bottom: 0;
      z-index: 40;
      width: 18rem;
      overflow-y: auto;
      padding: 1.5rem;
      background-color: white;
      box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
      transform: translateX(100%);
      transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
      pointer-events: none;
    }
    html.dark #toc-aside {
      background-color: #1c1c1c;
    }
    #toc-aside.toc-open {
      transform: translateX(0);
      pointer-events: auto;
    }
  }

  /* Desktop: fade in/out, keeps layout space */
  @media (min-width: 1280px) {
    #toc-aside {
      display: block !important;
      transition: opacity 200ms ease;
      opacity: 1;
    }
    #toc-aside.xl-hidden {
      opacity: 0;
      pointer-events: none;
    }
  }
</style>

<script>
  (function () {
    let abort: AbortController | null = null;

    function setup() {
      abort?.abort();
      abort = new AbortController();
      const { signal } = abort;

      const tocBtn = document.getElementById('toc-toggle');
      const tocAside = document.getElementById('toc-aside');
      if (!tocBtn || !tocAside) return;

      tocBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isLarge = window.innerWidth >= 1280;
        if (isLarge) {
          const hidden = tocAside.classList.toggle('xl-hidden');
          tocBtn.setAttribute('aria-expanded', String(!hidden));
        } else {
          const open = tocAside.classList.toggle('toc-open');
          tocBtn.setAttribute('aria-expanded', String(open));
        }
      }, { signal });

      document.addEventListener('click', (e) => {
        if (
          !tocAside.contains(e.target as Node) &&
          !tocBtn.contains(e.target as Node) &&
          tocAside.classList.contains('toc-open')
        ) {
          tocAside.classList.remove('toc-open');
          tocBtn.setAttribute('aria-expanded', 'false');
        }
      }, { signal });
    }

    setup();
    document.addEventListener('astro:after-swap', setup);
  })();
</script>
