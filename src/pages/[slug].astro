---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import ArticleAuthorHeader from '../components/ArticleAuthorHeader.vue';
import ArticleAuthorFooter from '../components/ArticleAuthorFooter.vue';
import TableOfContents from '../components/TableOfContents.vue';
import { getPostAuthors } from '../utils/authors';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const authors = await getPostAuthors(post.data.authors);

const coverImage = post.data.cover || post.data.thumbnail;
---

<BaseLayout title={post.data.title} description={post.data.excerpt} ogImage={coverImage}>
  <Navbar />
  <main class="mx-auto max-w-6xl px-4 py-8">
    {
      coverImage && (
        <img
          src={coverImage}
          alt={post.data.title}
          class="mb-8 h-64 w-full rounded-xl object-cover md:h-80"
        />
      )
    }

    <div class="flex gap-8">
      <!-- Article content -->
      <article class="min-w-0 flex-1">
        <h1
          class="mb-4 text-3xl font-bold leading-tight text-gray-900 dark:text-gray-100 md:text-4xl"
        >
          {post.data.title}
        </h1>

        <!-- Author header -->
        <div class="mb-6 flex items-center gap-4">
          <ArticleAuthorHeader authors={authors} client:load />
          <div class="text-sm text-gray-500 dark:text-gray-400">
            {
              post.data.date.toLocaleDateString('zh-TW', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })
            }
          </div>
        </div>

        <!-- Categories -->
        {
          post.data.categories.length > 0 && (
            <div class="mb-8 flex flex-wrap gap-2">
              {post.data.categories.map((cat) => (
                <a
                  href={`/categories/${encodeURIComponent(cat)}`}
                  class="rounded-full bg-primary/10 px-3 py-1 text-xs font-medium text-primary transition-colors hover:bg-primary/20"
                >
                  {cat}
                </a>
              ))}
            </div>
          )
        }

        <!-- Content -->
        <div
          class="prose prose-lg max-w-none dark:prose-invert prose-headings:font-bold prose-a:text-primary prose-code:text-primary prose-code:before:content-none prose-code:after:content-none prose-table:text-sm prose-img:rounded-lg"
        >
          <Content />
        </div>

        <!-- Author footer -->
        <ArticleAuthorFooter authors={authors} client:load />
      </article>

      <!-- TOC sidebar -->
      {
        headings.length > 0 && (
          <aside class="hidden w-64 shrink-0 xl:block">
            <TableOfContents headings={headings} client:load />
          </aside>
        )
      }
    </div>
  </main>
</BaseLayout>
