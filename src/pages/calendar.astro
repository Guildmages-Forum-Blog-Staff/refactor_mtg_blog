---
import ical from 'node-ical';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';

const ICAL_URL =
  'https://calendar.google.com/calendar/ical/2782072e99e58fdfd8359b71f7fcd3690ac4fd088727d1d47be063132a41f487%40group.calendar.google.com/public/basic.ics';

interface CalEvent {
  uid: string;
  summary: string;
  start: Date;
  end: Date;
  description?: string;
  location?: string;
  url?: string;
}

let events: CalEvent[] = [];

try {
  const data = await Promise.race([
    ical.async.fromURL(ICAL_URL),
    new Promise<never>((_, reject) =>
      setTimeout(() => reject(new Error('iCal fetch timed out')), 10_000),
    ),
  ]);

  events = Object.values(data)
    .filter((e: any) => e.type === 'VEVENT' && e.start instanceof Date)
    .map((e: any) => ({
      uid: e.uid ?? '',
      summary: e.summary ?? '(無標題)',
      start: e.start as Date,
      end: e.end as Date,
      description: e.description,
      location: e.location,
      url: e.url,
    }))
    .sort((a, b) => a.start.valueOf() - b.start.valueOf());
} catch (err) {
  console.error('Failed to fetch calendar:', err);
}

const now = new Date();
const syncedAt = now.toLocaleString('zh-TW', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
});
const upcoming = events.filter((e) => e.end >= now);
const past = events.filter((e) => e.end < now).reverse();

function formatDate(d: Date) {
  return d.toLocaleDateString('zh-TW', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    weekday: 'short',
  });
}

function formatTime(d: Date): string | null {
  const h = d.getHours();
  const m = d.getMinutes();
  if (h === 0 && m === 0) return null;
  return d.toLocaleTimeString('zh-TW', { hour: '2-digit', minute: '2-digit', hour12: false });
}

function isAllDay(start: Date, end: Date) {
  return formatTime(start) === null && formatTime(end) === null;
}

function linkifyText(text: string): string {
  const urlRegex = /https?:\/\/[^\s<>"]+/g;
  const parts: string[] = [];
  let lastIndex = 0;
  let match: RegExpExecArray | null;

  while ((match = urlRegex.exec(text)) !== null) {
    const before = text
      .slice(lastIndex, match.index)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\n/g, '<br>');
    parts.push(before);

    const url = match[0].replace(/"/g, '&quot;');
    const display = match[0].replace(/&/g, '&amp;');
    parts.push(
      `<a href="${url}" target="_blank" rel="noopener noreferrer" class="text-primary underline hover:opacity-80 break-all">${display}</a>`,
    );

    lastIndex = match.index + match[0].length;
  }

  const tail = text
    .slice(lastIndex)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\n/g, '<br>');
  parts.push(tail);

  return parts.join('');
}
---

<BaseLayout title="活動日曆 | Guildmages' Forum">
  <Navbar />
  <main class="mx-auto max-w-4xl px-4 py-10">
    <div class="mb-10 rounded-2xl border border-white/30 bg-white/60 p-6 shadow-lg backdrop-blur-md dark:border-white/10 dark:bg-dark-bg/60">
      <h1 class="mb-2 text-3xl font-bold text-gray-900 dark:text-gray-100">活動日曆</h1>
      <p class="text-sm text-gray-400 dark:text-dark-fg/50">
        資料來自 Google 日曆，每次部署自動同步。
      </p>
      <p class="mt-1 text-xs text-gray-400 dark:text-dark-fg/40">
        上次同步：{syncedAt}
      </p>
    </div>

    {
      upcoming.length === 0 && past.length === 0 && (
        <p class="text-gray-500 dark:text-dark-fg/50">目前無活動資料。</p>
      )
    }

    {
      upcoming.length > 0 && (
        <section class="mb-14">
          <h2 class="mb-6 text-lg font-bold text-gray-700 dark:text-dark-fg/70">即將到來</h2>
          <div class="flex flex-col gap-4">
            {upcoming.map((ev) => (
              <div class="flex gap-4 rounded-xl border border-white/40 bg-white/70 p-5 shadow-sm backdrop-blur-md transition-shadow hover:shadow-md dark:border-white/10 dark:bg-dark-bg/60">
                <!-- Date badge -->
                <div class="flex w-16 shrink-0 flex-col items-center justify-center rounded-lg bg-primary/10 py-2 text-center">
                  <span class="text-xs font-semibold text-primary">
                    {ev.start.toLocaleDateString('zh-TW', { month: 'short' })}
                  </span>
                  <span class="text-2xl font-bold leading-none text-primary">
                    {ev.start.getDate()}
                  </span>
                </div>

                <!-- Details -->
                <div class="flex min-w-0 flex-col gap-1">
                  {ev.url ? (
                    <a
                      href={ev.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="truncate text-base font-semibold text-gray-900 transition-colors hover:text-primary dark:text-dark-fg"
                    >
                      {ev.summary}
                    </a>
                  ) : (
                    <span class="truncate text-base font-semibold text-gray-900 dark:text-dark-fg">
                      {ev.summary}
                    </span>
                  )}

                  <div class="flex flex-wrap gap-x-3 gap-y-1 text-xs text-gray-500 dark:text-dark-fg/50">
                    <span>
                      {isAllDay(ev.start, ev.end)
                        ? formatDate(ev.start)
                        : `${formatDate(ev.start)} ${formatTime(ev.start)} – ${formatTime(ev.end)}`}
                    </span>
                    {ev.location && <span>📍 {ev.location}</span>}
                  </div>

                  {ev.description && (
                    <p
                      class="mt-1 line-clamp-2 text-sm text-gray-600 dark:text-dark-fg/70"
                      set:html={linkifyText(ev.description)}
                    />
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      past.length > 0 && (
        <section>
          <h2 class="mb-6 text-lg font-bold text-gray-700 dark:text-dark-fg/70">過去活動</h2>
          <div class="flex flex-col gap-3">
            {past.map((ev) => (
              <div class="flex gap-4 rounded-xl border border-white/20 bg-white/40 p-4 opacity-70 backdrop-blur-sm dark:border-white/5 dark:bg-white/5">
                <div class="flex w-14 shrink-0 flex-col items-center justify-center rounded-lg bg-gray-200 py-2 text-center dark:bg-white/10">
                  <span class="text-xs font-semibold text-gray-500 dark:text-dark-fg/50">
                    {ev.start.toLocaleDateString('zh-TW', { month: 'short' })}
                  </span>
                  <span class="text-xl font-bold leading-none text-gray-500 dark:text-dark-fg/50">
                    {ev.start.getDate()}
                  </span>
                </div>

                <div class="flex min-w-0 flex-col gap-0.5">
                  {ev.url ? (
                    <a
                      href={ev.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="truncate text-sm font-medium text-gray-600 line-through transition-colors hover:text-primary dark:text-dark-fg/60"
                    >
                      {ev.summary}
                    </a>
                  ) : (
                    <span class="truncate text-sm font-medium text-gray-600 line-through dark:text-dark-fg/60">
                      {ev.summary}
                    </span>
                  )}
                  <span class="text-xs text-gray-400 dark:text-dark-fg/40">
                    {formatDate(ev.start)}
                    {!isAllDay(ev.start, ev.end) && ` ${formatTime(ev.start)}`}
                    {ev.location && ` · ${ev.location}`}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>
