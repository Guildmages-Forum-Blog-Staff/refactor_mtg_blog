---
import ical, { type ParameterValue, type VEvent } from 'node-ical';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import { formatEventDate, eventBadge } from '../utils/calendar';

const ICAL_URL =
  'https://calendar.google.com/calendar/ical/2782072e99e58fdfd8359b71f7fcd3690ac4fd088727d1d47be063132a41f487%40group.calendar.google.com/public/basic.ics';

interface CalEvent {
  uid: string;
  summary: string;
  start: Date;
  end: Date;
  allDay: boolean;
  description?: string;
  location?: string;
  url?: string;
}

function paramValueToString(v: ParameterValue | undefined): string | undefined {
  if (v == null) return undefined;
  return typeof v === 'string' ? v : v.val;
}

let events: CalEvent[] = [];

try {
  const data = await Promise.race([
    ical.async.fromURL(ICAL_URL),
    new Promise<never>((_, reject) =>
      setTimeout(() => reject(new Error('iCal fetch timed out')), 10_000),
    ),
  ]);

  events = Object.values(data)
    .filter((e): e is VEvent => !!e && e.type === 'VEVENT' && e.start instanceof Date)
    .map((e) => ({
      uid: e.uid,
      summary: paramValueToString(e.summary) ?? '(無標題)',
      start: e.start,
      end: e.end instanceof Date ? e.end : e.start,
      allDay: e.datetype === 'date',
      description: paramValueToString(e.description),
      location: paramValueToString(e.location),
      url: e.url,
    }))
    .sort((a, b) => a.start.valueOf() - b.start.valueOf());
} catch (err) {
  console.error('Failed to fetch calendar:', err);
}

const now = new Date();
const syncedAt = now.toLocaleString('zh-TW', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
});
const upcoming = events.filter((e) => e.end >= now);
const past = events.filter((e) => e.end < now).reverse();

function linkifyText(text: string): string {
  const normalized = text.replace(/<br\s*\/?>/gi, '\n');
  const stripped = normalized.replace(/<a\b[^>]*>(.*?)<\/a>/gis, '$1');
  const urlRegex = /https?:\/\/[^\s<>"]+/g;
  const parts: string[] = [];
  let lastIndex = 0;
  let match: RegExpExecArray | null;

  while ((match = urlRegex.exec(stripped)) !== null) {
    const before = stripped
      .slice(lastIndex, match.index)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\n/g, '<br>');
    parts.push(before);

    const rawUrl = match[0].replace(/[.,;:!?)\]]+$/, '');
    urlRegex.lastIndex = match.index + rawUrl.length;
    const url = rawUrl.replace(/"/g, '&quot;');
    const display = rawUrl.replace(/&/g, '&amp;');
    parts.push(
      `<a href="${url}" target="_blank" rel="noopener noreferrer" class="text-primary underline hover:opacity-80 break-all">${display}</a>`,
    );

    lastIndex = match.index + rawUrl.length;
  }

  const tail = stripped
    .slice(lastIndex)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\n/g, '<br>');
  parts.push(tail);

  return parts.join('');
}
---

<BaseLayout title="活動日曆 | Guildmages' Forum">
  <Navbar />
  <main class="mx-auto max-w-4xl px-4 py-10">
    <div
      class="dark:bg-dark-bg/60 mb-10 rounded-2xl border border-white/30 bg-white/60 p-6 shadow-lg backdrop-blur-md dark:border-white/10"
    >
      <h1 class="mb-2 text-3xl font-bold text-gray-900 dark:text-gray-100">活動日曆</h1>
      <p class="dark:text-dark-fg/50 text-sm text-gray-400">
        資料來自 Google 日曆，每次部署自動同步。
      </p>
      <p class="dark:text-dark-fg/40 mt-1 text-xs text-gray-400">
        上次同步：{syncedAt}
      </p>
    </div>

    {
      upcoming.length === 0 && past.length === 0 && (
        <p class="dark:text-dark-fg/50 text-gray-500">目前無活動資料。</p>
      )
    }

    {
      upcoming.length > 0 && (
        <section class="mb-14">
          <h2 class="dark:text-dark-fg/70 mb-6 text-lg font-bold text-gray-700">即將到來</h2>
          <div class="flex flex-col gap-4">
            {upcoming.map((ev) => {
              const dateText = formatEventDate(ev.start, ev.end, ev.allDay);
              const badge = eventBadge(ev.start, ev.end, ev.allDay);
              return (
                <div
                  class="dark:bg-dark-bg/60 flex cursor-pointer gap-4 rounded-xl border border-white/40 bg-white/70 p-5 shadow-sm backdrop-blur-md transition-shadow hover:shadow-md dark:border-white/10"
                  data-cal-card={ev.uid}
                  data-summary={ev.summary}
                  data-date={dateText}
                  data-location-html={ev.location ? linkifyText(ev.location) : ''}
                  data-description-html={ev.description ? linkifyText(ev.description) : ''}
                  data-url={ev.url ?? ''}
                >
                  {/* Date badge; a bottom bar marks multi-day events */}
                  <div
                    class="bg-primary/10 flex w-16 shrink-0 flex-col items-center justify-center rounded-lg py-2 text-center"
                    title={badge.multiDay ? `共 ${badge.spanDays} 天` : undefined}
                  >
                    <span class="text-primary text-xs font-semibold">{badge.month}</span>
                    <span class="text-primary text-2xl leading-none font-bold">{badge.day}</span>
                    {badge.multiDay && (
                      <span class="bg-primary/70 mt-1 h-1 w-6 rounded-full" aria-hidden="true" />
                    )}
                  </div>

                  {/* Details */}
                  <div class="flex min-w-0 flex-col gap-1">
                    {ev.url ? (
                      <a
                        href={ev.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-primary dark:text-dark-fg truncate text-base font-semibold text-gray-900 transition-colors"
                      >
                        {ev.summary}
                      </a>
                    ) : (
                      <span class="dark:text-dark-fg truncate text-base font-semibold text-gray-900">
                        {ev.summary}
                      </span>
                    )}

                    <div class="dark:text-dark-fg/50 flex flex-wrap gap-x-3 gap-y-1 text-xs text-gray-500">
                      <span>{dateText}</span>
                      {ev.location && <span set:html={`📍 ${linkifyText(ev.location)}`} />}
                    </div>

                    {ev.description && (
                      <p
                        class="dark:text-dark-fg/70 mt-1 line-clamp-2 text-sm text-gray-600"
                        set:html={linkifyText(ev.description)}
                      />
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      )
    }

    {
      past.length > 0 && (
        <section>
          <h2 class="dark:text-dark-fg/70 mb-6 text-lg font-bold text-gray-700">過去活動</h2>
          <div class="flex flex-col gap-3">
            {past.map((ev) => {
              const dateText = formatEventDate(ev.start, ev.end, ev.allDay);
              const badge = eventBadge(ev.start, ev.end, ev.allDay);
              return (
                <div
                  class="flex cursor-pointer gap-4 rounded-xl border border-white/20 bg-white/40 p-4 opacity-70 backdrop-blur-sm dark:border-white/5 dark:bg-white/5"
                  data-cal-card={ev.uid}
                  data-summary={ev.summary}
                  data-date={dateText}
                  data-location-html={ev.location ? linkifyText(ev.location) : ''}
                  data-description-html={ev.description ? linkifyText(ev.description) : ''}
                  data-url={ev.url ?? ''}
                >
                  <div
                    class="flex w-14 shrink-0 flex-col items-center justify-center rounded-lg bg-gray-200 py-2 text-center dark:bg-white/10"
                    title={badge.multiDay ? `共 ${badge.spanDays} 天` : undefined}
                  >
                    <span class="dark:text-dark-fg/50 text-xs font-semibold text-gray-500">
                      {badge.month}
                    </span>
                    <span class="dark:text-dark-fg/50 text-xl leading-none font-bold text-gray-500">
                      {badge.day}
                    </span>
                    {badge.multiDay && (
                      <span
                        class="mt-1 h-1 w-5 rounded-full bg-gray-400 dark:bg-white/30"
                        aria-hidden="true"
                      />
                    )}
                  </div>

                  <div class="flex min-w-0 flex-col gap-0.5">
                    {ev.url ? (
                      <a
                        href={ev.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-primary dark:text-dark-fg/60 truncate text-sm font-medium text-gray-600 line-through transition-colors"
                      >
                        {ev.summary}
                      </a>
                    ) : (
                      <span class="dark:text-dark-fg/60 truncate text-sm font-medium text-gray-600 line-through">
                        {ev.summary}
                      </span>
                    )}
                    <span class="dark:text-dark-fg/40 text-xs text-gray-400">
                      {dateText}
                      {ev.location && <span set:html={` · ${linkifyText(ev.location)}`} />}
                    </span>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      )
    }

    <!-- Event detail modal -->
    <div
      id="cal-modal"
      class="fixed inset-0 z-50 hidden items-center justify-center p-4"
      aria-modal="true"
      role="dialog"
      aria-labelledby="cal-modal-title"
    >
      <div id="cal-modal-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
      <div
        class="dark:bg-dark-bg/95 relative z-10 w-full max-w-lg overflow-y-auto rounded-2xl border border-white/30 bg-white/95 p-6 shadow-2xl dark:border-white/10"
        style="max-height: 90vh"
      >
        <button
          id="cal-modal-close"
          class="absolute top-4 right-4 rounded-full p-1 text-gray-400 transition-colors hover:text-gray-700 dark:hover:text-gray-200"
          aria-label="關閉"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M4 4l12 12M16 4L4 16"></path>
          </svg>
        </button>
        <h2
          id="cal-modal-title"
          class="dark:text-dark-fg mb-3 pr-8 text-xl font-bold text-gray-900"
        >
        </h2>
        <p id="cal-modal-date" class="dark:text-dark-fg/60 mb-1 text-sm text-gray-500"></p>
        <p id="cal-modal-location" class="dark:text-dark-fg/60 mb-3 text-sm text-gray-500" hidden>
        </p>
        <div
          id="cal-modal-description"
          class="dark:text-dark-fg/80 [&_a]:text-primary mb-4 text-sm leading-relaxed text-gray-700 [&_a]:break-all [&_a]:underline"
          hidden
        >
        </div>
        <a
          id="cal-modal-link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="bg-primary inline-block rounded-lg px-4 py-2 text-sm font-semibold text-white transition-opacity hover:opacity-80"
          hidden
        >
          查看活動連結 →
        </a>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  const modal = document.getElementById('cal-modal')!;
  const backdrop = document.getElementById('cal-modal-backdrop')!;
  const closeBtn = document.getElementById('cal-modal-close')!;
  const titleEl = document.getElementById('cal-modal-title')!;
  const dateEl = document.getElementById('cal-modal-date')!;
  const locationEl = document.getElementById('cal-modal-location')!;
  const descEl = document.getElementById('cal-modal-description')!;
  const linkEl = document.getElementById('cal-modal-link') as HTMLAnchorElement;

  // Safely reconstruct DOM from linkifyText-generated HTML without using innerHTML.
  // Only <br> and <a href="https?://..."> nodes are preserved; everything else is text.
  function renderSafeHtml(dest: HTMLElement, html: string) {
    dest.textContent = '';
    const doc = new DOMParser().parseFromString(html, 'text/html');
    function walk(src: Node, target: HTMLElement) {
      for (const child of src.childNodes) {
        if (child.nodeType === Node.TEXT_NODE) {
          target.appendChild(document.createTextNode(child.textContent ?? ''));
        } else if (child.nodeType === Node.ELEMENT_NODE) {
          const el = child as Element;
          if (el.tagName === 'BR') {
            target.appendChild(document.createElement('br'));
          } else if (el.tagName === 'A' && /^https?:\/\//.test(el.getAttribute('href') ?? '')) {
            const a = document.createElement('a');
            a.href = el.getAttribute('href')!;
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
            a.textContent = el.textContent ?? '';
            target.appendChild(a);
          } else {
            walk(el, target);
          }
        }
      }
    }
    walk(doc.body, dest);
  }

  function openModal(card: HTMLElement) {
    titleEl.textContent = card.dataset.summary ?? '';
    dateEl.textContent = card.dataset.date ?? '';

    const loc = card.dataset.locationHtml;
    if (loc) {
      renderSafeHtml(locationEl as HTMLElement, '📍 ' + loc);
      locationEl.hidden = false;
    } else {
      locationEl.hidden = true;
    }

    const desc = card.dataset.descriptionHtml;
    if (desc) {
      renderSafeHtml(descEl as HTMLElement, desc);
      descEl.hidden = false;
    } else {
      descEl.hidden = true;
    }

    const url = card.dataset.url;
    if (url) {
      linkEl.href = url;
      linkEl.hidden = false;
    } else {
      linkEl.hidden = true;
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLElement>('[data-cal-card]').forEach((card) => {
    card.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) return;
      openModal(card);
    });
  });

  backdrop.addEventListener('click', closeModal);
  closeBtn.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>
