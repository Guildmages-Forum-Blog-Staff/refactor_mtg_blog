---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPathsOptions } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import ArticleAuthorFooter from '../../../components/ArticleAuthorFooter.vue';
import type { AuthorPaginatedPostsProps } from '../../../utils/pagination';
import { postSlug, sortByDateDesc } from '../../../utils/posts';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const [authors, posts] = await Promise.all([getCollection('authors'), getCollection('posts')]);

  const authorId = (id: string) => id.replace(/\.ya?ml$/, '');

  return authors.flatMap((author) => {
    const authorPosts = sortByDateDesc(
      posts.filter(
        (p) =>
          p.data.authors.includes(authorId(author.id)) ||
          p.data.authors.includes(author.data.username),
      ),
    );
    return paginate(authorPosts, {
      params: { username: authorId(author.id) },
      props: { author },
      pageSize: 20,
    });
  });
}

const { username } = Astro.params;
const { author, page } = Astro.props as AuthorPaginatedPostsProps;

const byYear = page.data.reduce<Record<number, CollectionEntry<'posts'>[]>>((acc, post) => {
  const year = post.data.date.getFullYear();
  (acc[year] ??= []).push(post);
  return acc;
}, {});

const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);

function getPaginationItems(current: number, last: number): (number | '...')[] {
  if (last <= 1) return [1];
  const delta = 2;
  const pages: number[] = [];
  for (let i = 1; i <= last; i++) {
    if (i === 1 || i === last || (i >= current - delta && i <= current + delta)) pages.push(i);
  }
  const result: (number | '...')[] = [];
  let prev: number | null = null;
  for (const p of pages) {
    if (prev !== null) {
      if (p - prev === 2) result.push(prev + 1);
      else if (p - prev > 2) result.push('...');
    }
    result.push(p);
    prev = p;
  }
  return result;
}

const paginationItems = getPaginationItems(page.currentPage, page.lastPage);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const avatar = author.data.avatar.startsWith('/')
  ? `${base}${author.data.avatar}`
  : author.data.avatar;
const authorBase = `${import.meta.env.BASE_URL}authors/${username}`;
const authorId = author.id.replace(/\.ya?ml$/, '');
const authorCard = [
  {
    id: authorId,
    username: author.data.username,
    name: author.data.name,
    avatar,
    url: author.data.url,
    intro: author.data.intro,
  },
];
---

<BaseLayout
  title={page.currentPage === 1
    ? `${author.data.name} | Guildmages' Forum`
    : `${author.data.name} — Page ${page.currentPage} | Guildmages' Forum`}
>
  <Navbar />
  <main class="mx-auto max-w-3xl px-4 py-10">
    <div class="dark:bg-dark-bg/80 rounded-2xl bg-white/80 p-6 backdrop-blur-sm">
      <!-- Author profile -->
      <ArticleAuthorFooter authors={authorCard} client:load />
      <p class="dark:text-dark-fg/50 mt-2 mb-10 text-sm text-gray-400">{page.total} 篇文章</p>

      <!-- Posts by year -->
      <div class="flex flex-col gap-10">
        {
          years.map((year) => (
            <section>
              <h2 class="dark:text-dark-fg/60 mb-4 border-b border-gray-200 pb-2 text-lg font-bold text-gray-500 dark:border-gray-700">
                {year}
              </h2>
              <ul class="flex flex-col gap-4">
                {byYear[year].map((post) => {
                  const slug = postSlug(post.id);
                  return (
                    <li class="flex items-baseline justify-between gap-4">
                      <a
                        href={`${import.meta.env.BASE_URL}${slug}`}
                        class="hover:text-primary dark:text-dark-fg flex-1 text-base font-medium text-gray-900 transition-colors"
                      >
                        {post.data.title}
                      </a>
                      <time class="dark:text-dark-fg/50 shrink-0 text-sm text-gray-400">
                        {post.data.date.toLocaleDateString('zh-TW', {
                          month: '2-digit',
                          day: '2-digit',
                        })}
                      </time>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))
        }
      </div>

      {
        page.lastPage > 1 && (
          <nav class="mt-12 flex items-center justify-between" aria-label="Pagination">
            <div>
              {page.url.prev ? (
                <a
                  href={page.url.prev}
                  class="hover:bg-primary dark:bg-dark-bg dark:text-dark-fg/70 dark:hover:bg-primary flex items-center gap-1 rounded-md bg-white px-3 py-2 text-sm font-medium text-gray-600 transition-colors hover:text-white dark:hover:text-white"
                >
                  ← Prev
                </a>
              ) : (
                <span class="dark:text-dark-fg/30 flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-gray-300">
                  ← Prev
                </span>
              )}
            </div>

            <div class="flex items-center gap-1">
              {paginationItems.map((item) =>
                item === '...' ? (
                  <span class="dark:text-dark-fg/30 px-1 text-sm text-gray-400">…</span>
                ) : (
                  <a
                    href={item === 1 ? `${authorBase}/` : `${authorBase}/${item}`}
                    class={`min-w-[2rem] rounded-md px-2 py-1 text-center text-sm font-medium transition-colors ${
                      item === page.currentPage
                        ? 'bg-primary text-white'
                        : 'hover:bg-primary dark:bg-dark-bg dark:text-dark-fg/70 dark:hover:bg-primary bg-white text-gray-600 hover:text-white dark:hover:text-white'
                    }`}
                  >
                    {item}
                  </a>
                ),
              )}
            </div>

            <div>
              {page.url.next ? (
                <a
                  href={page.url.next}
                  class="hover:bg-primary dark:bg-dark-bg dark:text-dark-fg/70 dark:hover:bg-primary flex items-center gap-1 rounded-md bg-white px-3 py-2 text-sm font-medium text-gray-600 transition-colors hover:text-white dark:hover:text-white"
                >
                  Next →
                </a>
              ) : (
                <span class="dark:text-dark-fg/30 flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-gray-300">
                  Next →
                </span>
              )}
            </div>
          </nav>
        )
      }
    </div>
  </main>
</BaseLayout>
