---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/categories', label: 'Categories' },
  { href: '/about', label: 'About Us' },
  { href: '/contact', label: 'Contact Us' },
];

const friendLinks = [
  { href: 'https://www.facebook.com/guildmagesforumtw', label: "Guildmages' Forum 粉專" },
  { href: 'https://www.facebook.com/TainanMonkeyKing', label: '台南猴王的耍猴日常' },
  { href: 'https://www.facebook.com/Pignosemtgworld', label: '豬鼻子的mtg世界' },
  { href: 'https://www.facebook.com/share/1B41iFRdki', label: 'Faintmama の TCG實驗室' },
  { href: 'https://www.facebook.com/share/1CapWPjweM', label: 'GTPlayer' },
  { href: 'https://dominarialibrary.com', label: '多明納里亞圖書館' },
  { href: 'http://76vezffd.blogspot.com/', label: '塞克斯的MTG日誌' },
  { href: 'https://www.facebook.com/profile.php?id=61558862427620', label: 'Kappa The Gathering' },
  { href: 'http://mysticzonetw.blogspot.com/', label: 'Mystic Zone' },
  { href: 'https://linktr.ee/sparkdouble', label: 'Spark Double Podcast' },
  { href: 'https://www.facebook.com/UncleJund', label: '勇德大叔的日常' },
  { href: 'https://www.facebook.com/profile.php?id=100068751771443', label: '約力昂大叔 Uncle Yorion' },
  { href: 'https://www.facebook.com/profile.php?id=100063848411689', label: '鳥不喇基' },
  { href: 'https://facebook.com/profile.php?id=61567687550022', label: '下水道鱷魚' },
  { href: 'https://www.facebook.com/profile.php?id=100083415367398', label: '紅的喜氣' },
  { href: 'https://www.facebook.com/profile.php?id=100083345574225', label: '寬麵的遊戲頻道' },
  { href: 'https://tcglearning.com/', label: 'TCG 英文筆記' },
  { href: 'https://www.facebook.com/share/17LYnAQyLK', label: '黑色魔鬼' },
  { href: 'https://www.facebook.com/share/18c5jp2e6N', label: '只會打Fun Deck的APaul' },
  { href: 'https://www.facebook.com/share/1B8SnBZ8GX', label: '未央 p 也想玩 mtg' },
  { href: 'https://www.facebook.com/share/1Ah8becrrV', label: '皮皮韓魔風單卡特區' },
];
---

<header
  transition:persist
  class="sticky top-0 z-50 border-b border-gray-200 bg-white/90 backdrop-blur dark:border-gray-800 dark:bg-dark-bg/90"
>
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4">
    <a href="/" class="text-lg font-bold text-primary transition-opacity hover:opacity-80">
      Guildmages' Forum
    </a>

    <!-- Desktop links: hidden on mobile, flex on md+ -->
    <div class="hidden md:flex items-center gap-6">
      <ul class="flex gap-6 text-sm font-medium">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-gray-600 transition-colors hover:text-primary dark:text-dark-fg/70 dark:hover:text-primary"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <!-- Friends dropdown -->
        <li class="relative">
          <button
            id="friends-trigger"
            class="flex items-center gap-1 text-gray-600 transition-colors hover:text-primary dark:text-dark-fg/70 dark:hover:text-primary"
          >
            Friends
            <svg class="h-3.5 w-3.5 transition-transform" id="friends-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div
            id="friends-dropdown"
            class="absolute left-0 top-full z-50 mt-2 hidden w-64 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-lg dark:border-gray-700 dark:bg-dark-bg"
          >
            <ul class="py-1">
              {friendLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block px-4 py-2 text-sm text-gray-700 transition-colors hover:bg-gray-100 hover:text-primary dark:text-dark-fg/80 dark:hover:bg-white/10 dark:hover:text-primary"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </li>
      </ul>
      <button
        id="search-trigger"
        aria-label="搜尋"
        class="rounded-md p-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-dark-fg/70 dark:hover:bg-white/10 dark:hover:text-dark-fg"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 105 11a6 6 0 0012 0z" />
        </svg>
      </button>
      <button
        id="dark-mode-toggle"
        aria-label="Toggle dark mode"
        class="rounded-md p-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-dark-fg/70 dark:hover:bg-white/10 dark:hover:text-dark-fg"
      >
        <svg id="icon-sun" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 7a5 5 0 100 10 5 5 0 000-10z" />
        </svg>
        <svg id="icon-moon" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z" />
        </svg>
      </button>
    </div>

    <!-- Mobile right side: search + dark mode + hamburger -->
    <div class="flex items-center gap-1 md:hidden">
      <button
        id="search-trigger-mobile"
        aria-label="搜尋"
        class="rounded-md p-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-dark-fg/70 dark:hover:bg-white/10 dark:hover:text-dark-fg"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 105 11a6 6 0 0012 0z" />
        </svg>
      </button>
      <button
        id="dark-mode-toggle-mobile"
        aria-label="Toggle dark mode"
        class="rounded-md p-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-dark-fg/70 dark:hover:bg-white/10 dark:hover:text-dark-fg"
      >
        <svg id="icon-sun-mobile" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 7a5 5 0 100 10 5 5 0 000-10z" />
        </svg>
        <svg id="icon-moon-mobile" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z" />
        </svg>
      </button>
      <button
        id="nav-hamburger"
        aria-label="選單"
        aria-expanded="false"
        class="rounded-md p-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-dark-fg/70 dark:hover:bg-white/10 dark:hover:text-dark-fg"
      >
        <svg id="icon-hamburger" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile dropdown (hidden by default, shown when hamburger open) -->
  <div
    id="nav-mobile-menu"
    class="hidden border-t border-gray-200 bg-white/90 px-4 py-3 backdrop-blur dark:border-gray-800 dark:bg-dark-bg/90 md:hidden"
  >
    <ul class="flex flex-col gap-4 text-sm font-medium">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-gray-600 transition-colors hover:text-primary dark:text-dark-fg/70 dark:hover:text-primary"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between text-gray-600 dark:text-dark-fg/70">
            Friends
            <svg class="h-3.5 w-3.5 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </summary>
          <ul class="mt-3 flex flex-col gap-3 pl-3 border-l border-gray-200 dark:border-gray-700">
            {friendLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-gray-500 transition-colors hover:text-primary dark:text-dark-fg/60 dark:hover:text-primary"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </li>
    </ul>
  </div>
</header>

<!-- Search modal -->
<div id="search-overlay" class="fixed inset-0 z-[200] hidden">
  <div id="search-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
  <div class="relative flex min-h-full items-start justify-center px-4 pt-24">
    <div class="w-full max-w-2xl overflow-hidden rounded-2xl bg-white shadow-2xl dark:bg-dark-bg">
      <div class="flex items-center gap-3 border-b border-gray-200 px-4 dark:border-gray-700">
        <svg class="h-5 w-5 shrink-0 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 105 11a6 6 0 0012 0z" />
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder="搜尋文章…"
          autocomplete="off"
          class="flex-1 bg-transparent py-4 text-base text-gray-900 outline-none placeholder:text-gray-400 dark:text-dark-fg dark:placeholder:text-dark-fg/40"
        />
        <button id="search-close" class="shrink-0 rounded p-1 text-gray-400 transition-colors hover:text-gray-600 dark:hover:text-dark-fg">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div id="search-results" class="max-h-[60vh] overflow-y-auto p-2"></div>
    </div>
  </div>
</div>

<script>
  // Dark mode toggle
  const toggle = document.getElementById('dark-mode-toggle');
  const iconSun = document.getElementById('icon-sun');
  const iconMoon = document.getElementById('icon-moon');

  const toggleMobile = document.getElementById('dark-mode-toggle-mobile');
  const iconSunMobile = document.getElementById('icon-sun-mobile');
  const iconMoonMobile = document.getElementById('icon-moon-mobile');

  function applyTheme(dark: boolean) {
    document.documentElement.classList.toggle('dark', dark);
    iconSun!.classList.toggle('hidden', !dark);
    iconMoon!.classList.toggle('hidden', dark);
    iconSunMobile!.classList.toggle('hidden', !dark);
    iconMoonMobile!.classList.toggle('hidden', dark);
  }

  applyTheme(document.documentElement.classList.contains('dark'));

  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    iconSun!.classList.toggle('hidden', !isDark);
    iconMoon!.classList.toggle('hidden', isDark);
    iconSunMobile!.classList.toggle('hidden', !isDark);
    iconMoonMobile!.classList.toggle('hidden', isDark);
  });

  toggleMobile?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    iconSun!.classList.toggle('hidden', !isDark);
    iconMoon!.classList.toggle('hidden', isDark);
    iconSunMobile!.classList.toggle('hidden', !isDark);
    iconMoonMobile!.classList.toggle('hidden', isDark);
  });

  // Search modal
  const searchTrigger = document.getElementById('search-trigger');
  const searchTriggerMobile = document.getElementById('search-trigger-mobile');
  const searchOverlay = document.getElementById('search-overlay')!;
  const searchBackdrop = document.getElementById('search-backdrop');
  const searchClose = document.getElementById('search-close');
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const searchResults = document.getElementById('search-results')!;

  let pagefind: any = null;

  async function initPagefind() {
    if (pagefind) return;
    try {
      pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
      await pagefind.init();
    } catch {
      // only available after npm run build
    }
  }

  function setHint(text: string) {
    const p = document.createElement('p');
    p.className = 'px-3 py-6 text-center text-sm text-gray-400 dark:text-dark-fg/40';
    p.textContent = text;
    searchResults.replaceChildren(p);
  }

  function openSearch() {
    searchOverlay.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    searchInput.focus();
    if (searchResults.childElementCount === 0) setHint('輸入關鍵字開始搜尋');
    initPagefind();
  }

  function closeSearch() {
    searchOverlay.classList.add('hidden');
    document.body.style.overflow = '';
    searchInput.value = '';
    searchResults.replaceChildren();
  }

  searchTrigger?.addEventListener('click', openSearch);
  searchTriggerMobile?.addEventListener('click', openSearch);
  searchClose?.addEventListener('click', closeSearch);
  searchBackdrop?.addEventListener('click', closeSearch);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSearch();
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });

  searchInput?.addEventListener('input', async () => {
    const query = searchInput.value.trim();
    if (!query) { setHint('輸入關鍵字開始搜尋'); return; }

    if (!pagefind) {
      setHint('請先執行 npm run build 以建立搜尋索引');
      return;
    }

    const res = await pagefind.search(query);
    const items: any[] = await Promise.all(res.results.slice(0, 8).map((r: any) => r.data()));

    if (items.length === 0) { setHint('找不到相關文章'); return; }

    const fragment = document.createDocumentFragment();
    for (const item of items) {
      const a = document.createElement('a');
      a.href = item.url;
      a.className = 'block rounded-xl px-4 py-3 transition-colors hover:bg-gray-100 dark:hover:bg-white/10';

      const titleEl = document.createElement('div');
      titleEl.className = 'font-medium text-gray-900 dark:text-dark-fg';
      titleEl.textContent = item.meta?.title ?? '';

      const excerptEl = document.createElement('div');
      excerptEl.className = 'mt-0.5 line-clamp-2 text-sm text-gray-500 dark:text-dark-fg/60';
      // Strip pagefind's <mark> tags — textContent is XSS-safe
      excerptEl.textContent = (item.excerpt ?? '').replace(/<[^>]*>/g, '');

      a.append(titleEl, excerptEl);
      fragment.appendChild(a);
    }
    searchResults.replaceChildren(fragment);
  });

  // Friends dropdown
  const friendsTrigger = document.getElementById('friends-trigger');
  const friendsDropdown = document.getElementById('friends-dropdown');
  const friendsChevron = document.getElementById('friends-chevron');

  friendsTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = !friendsDropdown!.classList.contains('hidden');
    friendsDropdown!.classList.toggle('hidden', isOpen);
    friendsChevron!.style.transform = isOpen ? '' : 'rotate(180deg)';
  });

  document.addEventListener('click', () => {
    friendsDropdown?.classList.add('hidden');
    if (friendsChevron) friendsChevron.style.transform = '';
  });

  // Hamburger menu toggle
  const hamburger = document.getElementById('nav-hamburger');
  const mobileMenu = document.getElementById('nav-mobile-menu');
  const iconHamburger = document.getElementById('icon-hamburger');
  const iconClose = document.getElementById('icon-close');

  hamburger?.addEventListener('click', () => {
    mobileMenu!.classList.toggle('hidden');
    const isOpen = !mobileMenu!.classList.contains('hidden');
    hamburger.setAttribute('aria-expanded', String(isOpen));
    iconHamburger!.classList.toggle('hidden', isOpen);
    iconClose!.classList.toggle('hidden', !isOpen);
  });

  // Close mobile menu on page navigation
  document.addEventListener('astro:after-swap', () => {
    mobileMenu?.classList.add('hidden');
    hamburger?.setAttribute('aria-expanded', 'false');
    iconHamburger?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  });
</script>
