---
const base = import.meta.env.BASE_URL;
const navLinks = [
  { href: base, label: 'Home' },
  { href: `${base}categories`, label: 'Categories' },
  { href: `${base}about`, label: 'About Us' },
  { href: `${base}calendar`, label: 'Calendar' },
  { href: `${base}contact`, label: 'Contact Us' },
];

const friendLinks = [
  { href: 'https://www.facebook.com/guildmagesforumtw', label: "Guildmages' Forum 粉專" },
  { href: 'https://www.facebook.com/TainanMonkeyKing', label: '台南猴王的耍猴日常' },
  { href: 'https://www.facebook.com/Pignosemtgworld', label: '豬鼻子的mtg世界' },
  { href: 'https://www.facebook.com/share/1B41iFRdki', label: 'Faintmama の TCG實驗室' },
  { href: 'https://www.facebook.com/share/1CapWPjweM', label: 'GTPlayer' },
  { href: 'https://dominarialibrary.com', label: '多明納里亞圖書館' },
  { href: 'http://76vezffd.blogspot.com/', label: '塞克斯的MTG日誌' },
  { href: 'https://www.facebook.com/profile.php?id=61558862427620', label: 'Kappa The Gathering' },
  { href: 'http://mysticzonetw.blogspot.com/', label: 'Mystic Zone' },
  { href: 'https://linktr.ee/sparkdouble', label: 'Spark Double Podcast' },
  { href: 'https://www.facebook.com/UncleJund', label: '勇德大叔的日常' },
  {
    href: 'https://www.facebook.com/profile.php?id=100068751771443',
    label: '約力昂大叔 Uncle Yorion',
  },
  { href: 'https://www.facebook.com/profile.php?id=100063848411689', label: '鳥不喇基' },
  { href: 'https://facebook.com/profile.php?id=61567687550022', label: '下水道鱷魚' },
  { href: 'https://www.facebook.com/profile.php?id=100083415367398', label: '紅的喜氣' },
  { href: 'https://www.facebook.com/profile.php?id=100083345574225', label: '寬麵的遊戲頻道' },
  { href: 'https://tcglearning.com/', label: 'TCG 英文筆記' },
  { href: 'https://www.facebook.com/share/17LYnAQyLK', label: '黑色魔鬼' },
  { href: 'https://www.facebook.com/share/18c5jp2e6N', label: '只會打Fun Deck的APaul' },
  { href: 'https://www.facebook.com/share/1B8SnBZ8GX', label: '未央 p 也想玩 mtg' },
  { href: 'https://www.facebook.com/share/1Ah8becrrV', label: '皮皮韓魔風單卡特區' },
];
---

<header
  transition:persist
  class="sticky top-0 z-50 border-b border-gray-200 bg-white backdrop-blur dark:border-gray-800 dark:bg-dark-bg"
>
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4">
    <a href={base} class="text-lg font-bold text-primary transition-opacity hover:opacity-80">
      Guildmages' Forum
    </a>

    <!-- Desktop links: hidden on mobile, flex on md+ -->
    <div class="hidden items-center gap-6 md:flex">
      <ul class="flex gap-6 text-sm font-medium">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-gray-600 transition-colors hover:text-primary dark:text-dark-fg/70 dark:hover:text-primary"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <!-- Friends dropdown (desktop) -->
        <li class="relative">
          <button
            id="friends-trigger"
            class="flex items-center gap-1 text-gray-600 transition-colors hover:text-primary dark:text-dark-fg/70 dark:hover:text-primary"
          >
            Friends
            <svg
              class="h-3.5 w-3.5 transition-transform"
              id="friends-chevron"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div
            id="friends-dropdown"
            class="absolute left-0 top-full z-50 mt-2 hidden w-64 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-lg dark:border-gray-700 dark:bg-dark-bg"
          >
            <ul class="py-1">
              {
                friendLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="block px-4 py-2 text-sm text-gray-700 transition-colors hover:bg-gray-100 hover:text-primary dark:text-dark-fg/80 dark:hover:bg-white/10 dark:hover:text-primary"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
      </ul>
      <button
        id="search-trigger"
        aria-label="搜尋"
        class="rounded-md p-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-dark-fg/70 dark:hover:bg-white/10 dark:hover:text-dark-fg"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-4.35-4.35M17 11A6 6 0 105 11a6 6 0 0012 0z"></path>
        </svg>
      </button>
      <button
        id="dark-mode-toggle"
        aria-label="Toggle dark mode"
        class="rounded-md p-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-dark-fg/70 dark:hover:bg-white/10 dark:hover:text-dark-fg"
      >
        <svg
          id="icon-sun"
          class="hidden h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 7a5 5 0 100 10 5 5 0 000-10z"
          ></path>
        </svg>
        <svg
          id="icon-moon"
          class="hidden h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile right side: search + dark mode + hamburger -->
    <div class="flex items-center gap-1 md:hidden">
      <button
        id="search-trigger-mobile"
        aria-label="搜尋"
        class="rounded-md p-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-dark-fg/70 dark:hover:bg-white/10 dark:hover:text-dark-fg"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-4.35-4.35M17 11A6 6 0 105 11a6 6 0 0012 0z"></path>
        </svg>
      </button>
      <button
        id="dark-mode-toggle-mobile"
        aria-label="Toggle dark mode"
        class="rounded-md p-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-dark-fg/70 dark:hover:bg-white/10 dark:hover:text-dark-fg"
      >
        <svg
          id="icon-sun-mobile"
          class="hidden h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M17.657 17.657l-.707-.707M6.343 6.343l-.707-.707M12 7a5 5 0 100 10 5 5 0 000-10z"
          ></path>
        </svg>
        <svg
          id="icon-moon-mobile"
          class="hidden h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z"></path>
        </svg>
      </button>
      <button
        id="nav-hamburger"
        aria-label="選單"
        aria-expanded="false"
        class="rounded-md p-1.5 text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-900 dark:text-dark-fg/70 dark:hover:bg-white/10 dark:hover:text-dark-fg"
      >
        <svg
          id="icon-hamburger"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="icon-close"
          class="hidden h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile full-screen overlay -->
<div
  id="nav-mobile-overlay"
  class="fixed inset-0 z-[150] hidden overflow-hidden md:hidden"
  aria-hidden="true"
>
  <!-- Panels container -->
  <div class="relative h-full w-full">
    <!-- Main nav panel -->
    <div
      id="nav-panel-main"
      class="absolute inset-0 flex flex-col bg-white transition-transform duration-300 dark:bg-dark-bg"
      style="transform: translateX(100%)"
    >
      <!-- Panel header -->
      <div
        class="flex h-14 shrink-0 items-center justify-between border-b border-gray-200 px-4 dark:border-gray-800"
      >
        <span class="text-lg font-bold text-primary">選單</span>
        <button
          id="nav-overlay-close"
          aria-label="關閉選單"
          class="rounded-md p-1.5 text-gray-600 hover:bg-gray-100 dark:text-dark-fg/70 dark:hover:bg-white/10"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <!-- Nav links -->
      <ul class="flex flex-col overflow-y-auto px-4 py-6 text-base font-medium">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="flex items-center py-3 text-gray-700 transition-colors hover:text-primary dark:text-dark-fg/80 dark:hover:text-primary"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <!-- Friends → opens friends panel -->
        <li>
          <button
            id="mobile-friends-trigger"
            class="flex w-full items-center justify-between py-3 text-gray-700 transition-colors hover:text-primary dark:text-dark-fg/80 dark:hover:text-primary"
          >
            Friends
            <svg
              class="h-4 w-4 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </li>
      </ul>
    </div>

    <!-- Friends panel -->
    <div
      id="nav-panel-friends"
      class="absolute inset-0 flex flex-col bg-white transition-transform duration-300 dark:bg-dark-bg"
      style="transform: translateX(100%)"
    >
      <!-- Panel header -->
      <div
        class="flex h-14 shrink-0 items-center justify-between border-b border-gray-200 px-4 dark:border-gray-800"
      >
        <button
          id="mobile-friends-back"
          class="flex items-center gap-1 text-sm text-gray-600 hover:text-primary dark:text-dark-fg/70 dark:hover:text-primary"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
          </svg>
          Back
        </button>
        <span class="font-bold text-gray-900 dark:text-dark-fg">Friends</span>
        <button
          id="nav-overlay-close-2"
          aria-label="關閉選單"
          class="rounded-md p-1.5 text-gray-600 hover:bg-gray-100 dark:text-dark-fg/70 dark:hover:bg-white/10"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <!-- Friends links -->
      <ul class="flex flex-col overflow-y-auto px-4 py-6 text-base">
        {
          friendLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center py-3 text-gray-700 transition-colors hover:text-primary dark:text-dark-fg/80 dark:hover:text-primary"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<!-- Search modal -->
<div id="search-overlay" class="fixed inset-0 z-[200] hidden">
  <div id="search-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
  <div class="relative flex min-h-full items-start justify-center px-4 pt-24">
    <div class="w-full max-w-2xl overflow-hidden rounded-2xl bg-white shadow-2xl dark:bg-dark-bg">
      <div class="flex items-center gap-3 border-b border-gray-200 px-4 dark:border-gray-700">
        <svg
          class="h-5 w-5 shrink-0 text-gray-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 21l-4.35-4.35M17 11A6 6 0 105 11a6 6 0 0012 0z"></path>
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder="搜尋文章…"
          autocomplete="off"
          class="flex-1 bg-transparent py-4 text-base text-gray-900 outline-none placeholder:text-gray-400 dark:text-dark-fg dark:placeholder:text-dark-fg/40"
        />
        <button
          id="search-close"
          class="shrink-0 rounded p-1 text-gray-400 transition-colors hover:text-gray-600 dark:hover:text-dark-fg"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div id="search-results" class="max-h-[60vh] overflow-y-auto p-2"></div>
    </div>
  </div>
</div>

<script>
  // pagefind is module-level so it initialises once across navigations
  let pagefind: any = null;
  let navAbort: AbortController | null = null;

  function applyThemeIcons(dark: boolean) {
    document.getElementById('icon-sun')?.classList.toggle('hidden', !dark);
    document.getElementById('icon-moon')?.classList.toggle('hidden', dark);
    document.getElementById('icon-sun-mobile')?.classList.toggle('hidden', !dark);
    document.getElementById('icon-moon-mobile')?.classList.toggle('hidden', dark);
  }

  function setupNav() {
    // Abort all listeners from previous setup before re-attaching
    navAbort?.abort();
    navAbort = new AbortController();
    const { signal } = navAbort;

    // ── Theme icons ──────────────────────────────────────────────────────────
    applyThemeIcons(document.documentElement.classList.contains('dark'));

    function handleToggle() {
      const applyTheme = () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        applyThemeIcons(isDark);
      };
      if (!document.startViewTransition) {
        applyTheme();
        return;
      }
      document.documentElement.classList.add('is-theme-transitioning');
      const t = document.startViewTransition(applyTheme);
      t.finished.finally(() => document.documentElement.classList.remove('is-theme-transitioning'));
    }
    document
      .getElementById('dark-mode-toggle')
      ?.addEventListener('click', handleToggle, { signal });
    document
      .getElementById('dark-mode-toggle-mobile')
      ?.addEventListener('click', handleToggle, { signal });

    // ── Search ───────────────────────────────────────────────────────────────
    const searchOverlay = document.getElementById('search-overlay')!;
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const searchResults = document.getElementById('search-results')!;

    async function initPagefind() {
      if (pagefind) return;
      try {
        pagefind = await import(/* @vite-ignore */ `${import.meta.env.BASE_URL}pagefind/pagefind.js`);
        await pagefind.init();
      } catch {
        /* only available after npm run build */
      }
    }

    function setHint(text: string) {
      const p = document.createElement('p');
      p.className = 'px-3 py-6 text-center text-sm text-gray-400 dark:text-dark-fg/40';
      p.textContent = text;
      searchResults.replaceChildren(p);
    }

    function openSearch() {
      searchOverlay.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      searchInput.focus();
      if (searchResults.childElementCount === 0) setHint('輸入關鍵字開始搜尋');
      initPagefind();
    }

    function closeSearch() {
      searchOverlay.classList.add('hidden');
      document.body.style.overflow = '';
      searchInput.value = '';
      searchResults.replaceChildren();
    }

    document.getElementById('search-trigger')?.addEventListener('click', openSearch, { signal });
    document
      .getElementById('search-trigger-mobile')
      ?.addEventListener('click', openSearch, { signal });
    document.getElementById('search-close')?.addEventListener('click', closeSearch, { signal });
    document.getElementById('search-backdrop')?.addEventListener('click', closeSearch, { signal });

    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape') closeSearch();
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          openSearch();
        }
      },
      { signal },
    );

    searchInput?.addEventListener(
      'input',
      async () => {
        const query = searchInput.value.trim();
        if (!query) {
          setHint('輸入關鍵字開始搜尋');
          return;
        }
        if (!pagefind) {
          setHint('請先執行 npm run build 以建立搜尋索引');
          return;
        }

        const res = await pagefind.search(query);
        const items: any[] = await Promise.all(res.results.slice(0, 8).map((r: any) => r.data()));
        if (items.length === 0) {
          setHint('找不到相關文章');
          return;
        }

        const fragment = document.createDocumentFragment();
        for (const item of items) {
          const a = document.createElement('a');
          a.href = item.url;
          a.className =
            'block rounded-xl px-4 py-3 transition-colors hover:bg-gray-100 dark:hover:bg-white/10';
          const titleEl = document.createElement('div');
          titleEl.className = 'font-medium text-gray-900 dark:text-dark-fg';
          titleEl.textContent = item.meta?.title ?? '';
          const excerptEl = document.createElement('div');
          excerptEl.className = 'mt-0.5 line-clamp-2 text-sm text-gray-500 dark:text-dark-fg/60';
          excerptEl.textContent = (item.excerpt ?? '').replace(/<[^>]*>/g, '');
          a.append(titleEl, excerptEl);
          fragment.appendChild(a);
        }
        searchResults.replaceChildren(fragment);
      },
      { signal },
    );

    // ── Desktop Friends dropdown ──────────────────────────────────────────────
    const friendsDropdown = document.getElementById('friends-dropdown');
    const friendsChevron = document.getElementById('friends-chevron');

    document.getElementById('friends-trigger')?.addEventListener(
      'click',
      (e) => {
        e.stopPropagation();
        const isOpen = !friendsDropdown!.classList.contains('hidden');
        friendsDropdown!.classList.toggle('hidden', isOpen);
        friendsChevron!.style.transform = isOpen ? '' : 'rotate(180deg)';
      },
      { signal },
    );

    document.addEventListener(
      'click',
      () => {
        friendsDropdown?.classList.add('hidden');
        if (friendsChevron) friendsChevron.style.transform = '';
      },
      { signal },
    );

    // ── Mobile overlay ────────────────────────────────────────────────────────
    const hamburger = document.getElementById('nav-hamburger');
    const iconHamburger = document.getElementById('icon-hamburger');
    const iconClose = document.getElementById('icon-close');
    const overlay = document.getElementById('nav-mobile-overlay')!;
    const panelMain = document.getElementById('nav-panel-main')!;
    const panelFriends = document.getElementById('nav-panel-friends')!;

    function openOverlay() {
      overlay.classList.remove('hidden');
      overlay.removeAttribute('aria-hidden');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        panelMain.style.transform = 'translateX(0)';
        panelFriends.style.transform = 'translateX(100%)';
      });
      hamburger?.setAttribute('aria-expanded', 'true');
      iconHamburger?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    }

    function closeOverlay() {
      panelMain.style.transform = 'translateX(100%)';
      panelFriends.style.transform = 'translateX(100%)';
      document.body.style.overflow = '';
      hamburger?.setAttribute('aria-expanded', 'false');
      iconHamburger?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      setTimeout(() => {
        overlay.classList.add('hidden');
        overlay.setAttribute('aria-hidden', 'true');
      }, 300);
    }

    hamburger?.addEventListener('click', openOverlay, { signal });
    document
      .getElementById('nav-overlay-close')
      ?.addEventListener('click', closeOverlay, { signal });
    document
      .getElementById('nav-overlay-close-2')
      ?.addEventListener('click', closeOverlay, { signal });
    document.getElementById('mobile-friends-trigger')?.addEventListener(
      'click',
      () => {
        panelMain.style.transform = 'translateX(-100%)';
        panelFriends.style.transform = 'translateX(0)';
      },
      { signal },
    );
    document.getElementById('mobile-friends-back')?.addEventListener(
      'click',
      () => {
        panelMain.style.transform = 'translateX(0)';
        panelFriends.style.transform = 'translateX(100%)';
      },
      { signal },
    );
  }

  setupNav();
  document.addEventListener('astro:after-swap', setupNav);
</script>
