---
import type { CollectionEntry } from 'astro:content';
import { DATE_LOCALE, type Lang } from '../i18n';
import { SITE_TIME_ZONE } from '../utils/post-date';
import { useTranslations } from '../i18n/ui';
import { postUrl } from '../utils/posts';

interface Props {
  posts: CollectionEntry<'posts'>[];
  lang: Lang;
}

const { posts, lang } = Astro.props;
if (posts.length === 0) return;
const t = useTranslations(lang);
---

<section class="mt-12 border-t border-gray-200 pt-8 dark:border-gray-700">
  <h2 class="dark:text-dark-fg mb-6 text-xl font-bold text-gray-900">{t.relatedPosts}</h2>
  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    {
      posts.map((post) => {
        const cover = post.data.thumbnail || post.data.cover;
        return (
          <a
            href={postUrl(post.id)}
            class="group dark:bg-dark-bg flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white transition-shadow hover:shadow-md dark:border-gray-700"
          >
            {cover ? (
              <img
                src={cover}
                alt={post.data.title}
                loading="lazy"
                class="h-32 w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            ) : (
              <div class="bg-primary/10 h-32 w-full" />
            )}
            <div class="flex flex-1 flex-col p-3">
              <p class="dark:text-dark-fg line-clamp-2 text-sm leading-snug font-medium text-gray-900">
                {post.data.title}
              </p>
              <p class="dark:text-dark-fg/60 mt-1 text-xs text-gray-500">
                {post.data.date.toLocaleDateString(DATE_LOCALE[lang], {
                  timeZone: SITE_TIME_ZONE,
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
            </div>
          </a>
        );
      })
    }
  </div>
</section>
