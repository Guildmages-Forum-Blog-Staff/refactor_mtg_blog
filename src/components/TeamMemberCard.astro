---
import { localePath, type Lang } from '../i18n';
import { useTranslations } from '../i18n/ui';
import type { AuthorData } from '../utils/authors';

interface Props {
  id: string;
  /** Author from utils/authors (avatar already carries the base path). */
  data: AuthorData;
  lang: Lang;
  former?: boolean;
}

const { id, data, lang, former = false } = Astro.props;
const href = data.url || localePath(lang, `authors/${id}/`);
const avatarSrc = data.avatar;
---

<div class="flex items-start gap-6">
  <a href={href} class="shrink-0">
    <img
      src={avatarSrc}
      alt={data.name}
      width="160"
      height="160"
      loading="lazy"
      class="h-40 w-40 rounded-full border-2 border-gray-200 object-cover dark:border-gray-700"
    />
  </a>
  <div class="flex min-w-0 flex-col gap-1 pt-1">
    <h3 class="text-3xl font-bold text-gray-900 dark:text-gray-100">
      <a href={href} class="hover:text-primary transition-colors">
        {data.name}
      </a>
      {
        former && (
          <span class="ml-2 align-middle text-xs font-normal text-gray-400 dark:text-gray-500">
            {useTranslations(lang).honorary}
          </span>
        )
      }
    </h3>
    {
      data.intro.map((line: string) => (
        <p class="text-sm leading-relaxed text-gray-600 dark:text-gray-400" set:html={line} />
      ))
    }
  </div>
</div>
