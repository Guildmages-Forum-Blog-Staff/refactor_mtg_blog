---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryDescription, categoryLabel } from '../config/categories';
import Navbar from '../components/Navbar.astro';
import type { PaginatedPostsProps } from '../utils/pagination';
import { DATE_LOCALE, langFromPath, localePath } from '../i18n';
import { useTranslations } from '../i18n/ui';
import { postUrl } from '../utils/posts';

type Props = PaginatedPostsProps;

const { cat } = Astro.params as { cat: string };
const { page } = Astro.props;
const lang = langFromPath(Astro.url.pathname);
const t = useTranslations(lang);

const byYear = page.data.reduce<Record<number, CollectionEntry<'posts'>[]>>((acc, post) => {
  const year = post.data.date.getFullYear();
  (acc[year] ??= []).push(post);
  return acc;
}, {});

const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);

function getPaginationItems(current: number, last: number): (number | '...')[] {
  if (last <= 1) return [1];
  const delta = 2;
  const pages: number[] = [];
  for (let i = 1; i <= last; i++) {
    if (i === 1 || i === last || (i >= current - delta && i <= current + delta)) pages.push(i);
  }
  const result: (number | '...')[] = [];
  let prev: number | null = null;
  for (const p of pages) {
    if (prev !== null) {
      if (p - prev === 2) result.push(prev + 1);
      else if (p - prev > 2) result.push('...');
    }
    result.push(p);
    prev = p;
  }
  return result;
}

const paginationItems = getPaginationItems(page.currentPage, page.lastPage);
const catBase = localePath(lang, `categories/${cat}`);
const label = categoryLabel(cat, lang);
const description = categoryDescription(cat, lang);
---

<BaseLayout
  title={page.currentPage === 1
    ? `${label} | Categories`
    : `${label} — ${t.page(page.currentPage)} | Categories`}
  description={description}
>
  <Navbar />
  <main class="mx-auto max-w-3xl px-4 py-10">
    <div class="dark:bg-dark-bg/80 rounded-2xl bg-white/80 p-6 backdrop-blur-sm">
      <div class="mb-10">
        <a
          href={localePath(lang, 'categories/')}
          class="hover:text-primary text-sm text-gray-500 transition-colors"
        >
          {t.allCategories}
        </a>
        <h1 class="dark:text-dark-fg mt-2 text-2xl font-bold text-gray-900">{label}</h1>
        <p class="dark:text-dark-fg/70 mt-2 text-sm leading-relaxed text-gray-600">{description}</p>
        <p class="dark:text-dark-fg/50 mt-1 text-sm text-gray-400">{t.postCount(page.total)}</p>
      </div>

      <div class="flex flex-col gap-10">
        {
          years.map((year) => (
            <section>
              <h2 class="dark:text-dark-fg/60 mb-4 border-b border-gray-200 pb-2 text-lg font-bold text-gray-500 dark:border-gray-700">
                {year}
              </h2>
              <ul class="flex flex-col gap-4">
                {byYear[year].map((post) => {
                  return (
                    <li class="flex items-baseline justify-between gap-4">
                      <a
                        href={postUrl(post.id)}
                        class="hover:text-primary dark:text-dark-fg flex-1 text-base font-medium text-gray-900 transition-colors"
                      >
                        {post.data.title}
                      </a>
                      <time class="dark:text-dark-fg/50 shrink-0 text-sm text-gray-400">
                        {post.data.date.toLocaleDateString(DATE_LOCALE[lang], {
                          month: '2-digit',
                          day: '2-digit',
                        })}
                      </time>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))
        }
      </div>
    </div>

    {
      page.lastPage > 1 && (
        <nav class="mt-12 flex items-center justify-between" aria-label="Pagination">
          <div>
            {page.url.prev ? (
              <a
                href={page.url.prev}
                class="hover:bg-primary dark:bg-dark-bg dark:text-dark-fg/70 dark:hover:bg-primary flex items-center gap-1 rounded-md bg-white px-3 py-2 text-sm font-medium text-gray-600 transition-colors hover:text-white dark:hover:text-white"
              >
                {t.prev}
              </a>
            ) : (
              <span class="dark:text-dark-fg/30 flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-gray-300">
                {t.prev}
              </span>
            )}
          </div>

          <div class="flex items-center gap-1">
            {paginationItems.map((item) =>
              item === '...' ? (
                <span class="dark:text-dark-fg/30 px-1 text-sm text-gray-400">…</span>
              ) : (
                <a
                  href={item === 1 ? `${catBase}/` : `${catBase}/${item}/`}
                  class={`min-w-[2rem] rounded-md px-2 py-1 text-center text-sm font-medium transition-colors ${
                    item === page.currentPage
                      ? 'bg-primary text-white'
                      : 'hover:bg-primary dark:bg-dark-bg dark:text-dark-fg/70 dark:hover:bg-primary bg-white text-gray-600 hover:text-white dark:hover:text-white'
                  }`}
                >
                  {item}
                </a>
              ),
            )}
          </div>

          <div>
            {page.url.next ? (
              <a
                href={page.url.next}
                class="hover:bg-primary dark:bg-dark-bg dark:text-dark-fg/70 dark:hover:bg-primary flex items-center gap-1 rounded-md bg-white px-3 py-2 text-sm font-medium text-gray-600 transition-colors hover:text-white dark:hover:text-white"
              >
                {t.next}
              </a>
            ) : (
              <span class="dark:text-dark-fg/30 flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-gray-300">
                {t.next}
              </span>
            )}
          </div>
        </nav>
      )
    }
  </main>
</BaseLayout>
