---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import { langFromPath } from '../i18n';
import { useTranslations } from '../i18n/ui';

const t = useTranslations(langFromPath(Astro.url.pathname));
---

<BaseLayout title={t.contactTitle}>
  <Navbar />
  <main class="mx-auto max-w-4xl px-4 py-10">
    <div class="dark:bg-dark-bg/80 rounded-2xl bg-white/80 p-6 backdrop-blur-sm">
      <h1 class="mb-6 text-3xl font-bold text-gray-900 dark:text-gray-100">{t.contactTitle}</h1>

      <!-- General Contact -->
      <section class="mb-10">
        <h2 class="mb-4 text-xl font-semibold text-gray-800 dark:text-gray-200">
          {t.contactHeading}
        </h2>
        <div class="prose dark:prose-invert max-w-none">
          <ul class="space-y-2">
            <li>
              <a
                href="https://www.facebook.com/guildmagesforumtw"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary transition-colors hover:underline"
              >
                {t.facebookPage}
              </a>
            </li>
            <li>
              <a
                href="https://www.threads.com/@guildmagesforum.tw"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary transition-colors hover:underline"
              >
                Threads
              </a>
            </li>
            <li>
              <a
                href="mailto:guildmagesforumblog@gmail.com"
                class="text-primary transition-colors hover:underline"
              >
                Email
              </a>
            </li>
            <li>
              <a
                href="https://forms.gle/JDAoTFjB5zgjwYUY8"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary transition-colors hover:underline"
              >
                {t.reportForm}
              </a>
            </li>
          </ul>
        </div>
      </section>

      <!-- Article Submission -->
      <section class="mb-10">
        <h2 class="mb-4 text-xl font-semibold text-gray-800 dark:text-gray-200">
          {t.submissionHeading}
        </h2>
        <div
          class="rounded-xl border border-gray-200 bg-white/60 p-6 dark:border-gray-700 dark:bg-white/5"
        >
          <p class="mb-4 text-gray-700 dark:text-gray-300">{t.submissionBody}</p>
          <p class="mb-3 text-gray-700 dark:text-gray-300">{t.submissionSendTo}</p>
          <p class="mb-1 font-medium text-gray-900 dark:text-gray-100">
            <a
              href="mailto:guildmagesforumblog@gmail.com"
              class="text-primary transition-colors hover:underline"
            >
              guildmagesforumblog@gmail.com
            </a>
          </p>
          <p class="mt-4 text-sm text-gray-600 dark:text-gray-400">
            {t.submissionSubject}<span
              class="text-primary rounded bg-gray-100 px-2 py-0.5 font-mono dark:bg-white/10"
              >{t.submissionSubjectExample}</span
            >
          </p>
        </div>
      </section>

      <!-- Disclaimer -->
      <section class="mb-10">
        <h2 class="mb-4 text-xl font-semibold text-gray-800 dark:text-gray-200">
          {t.disclaimerHeading}
        </h2>
        <div class="prose dark:prose-invert max-w-none">
          <ul class="space-y-2 text-gray-700 dark:text-gray-300">
            {t.disclaimer.map((line) => <li>{line}</li>)}
          </ul>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
